<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netframework4.7.2;net10.0;netstandard2.0</TargetFrameworks>
		<!-- Packaging -->
		<PackageDescription>A Metalama package providing licensing, telemetry and other configuration settings for projects using Metalama.</PackageDescription>
        
        <MetalamaBackstageDirectory Condition="'$(MetalamaBackstageDirectory)'==''">$(MSBuildProjectDirectory)</MetalamaBackstageDirectory>

    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Metalama.Testing.Hooks\Metalama.Testing.Hooks.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="System.IO.Hashing" />
        <PackageReference Include="System.Collections.Immutable" />
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
        <PackageReference Include="JetBrains.Profiler.SelfApi" Condition="'$(TargetFramework)'!='netstandard2.0'" />
        <PackageReference Include="Microsoft.Bcl.HashCode" />
        <PackageReference Include="System.Text.Json" VersionOverride="$(SystemTextJsonMinVersion)" NoWarn="NU1903" />
        <PackageReference Include="System.IO.Packaging" />
        <PackageReference Include="System.DirectoryServices" />
        <PackageReference Include="Microsoft.Win32.Registry" Condition="'$(TargetFramework)'=='netstandard2.0'" />
        <PackageReference Include="System.Threading.AccessControl" />
        <PackageReference Include="System.Threading.Tasks.Extensions" />
    </ItemGroup>

    <PropertyGroup>
        <RootNamespace>Metalama.Backstage</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- The files under Threading/ are also compiled into Metalama.Framework.CompilerExtensions and
             Metalama.Framework.DesignTime.Contracts, which can reference nothing. This symbol marks the copy that
             is part of Metalama.Backstage, and therefore the only one that takes part in dependency injection. -->
        <DefineConstants>$(DefineConstants);METALAMA_BACKSTAGE</DefineConstants>

        <!-- Marks a copy of those files that can reference Metalama.Testing.Hooks, and therefore has the test
             synchronization points. This is deliberately a separate symbol, because whether an assembly is
             Metalama.Backstage and whether it has the hooks are two independent questions: any project that
             compiles these files and gains a reference to Metalama.Testing.Hooks should define this one too. -->
        <DefineConstants>$(DefineConstants);HAS_METALAMA_TESTING_HOOKS</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="Telemetry\public.key" />
        <EmbeddedResource Include="$(MetalamaBackstageDirectory)\Telemetry\public.key" LogicalName="Metalama.Backstage.Telemetry.public.key" />
    </ItemGroup>
    

    <ItemGroup>
        <!-- By convention, we use InternalsVisibleTo only for test projects that must have access to internals. -->
        <InternalsVisibleTo Include="Metalama.Backstage.Tests" />
        <InternalsVisibleTo Include="Metalama.Backstage.Testing" />
    </ItemGroup>


</Project>
