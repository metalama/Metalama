<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <MetalamaBackstageDirectory>$(MSBuildProjectDirectory)\..\Metalama.Backstage</MetalamaBackstageDirectory>
        <OutputType>exe</OutputType>
        <RootNamespace>Metalama.Backstage</RootNamespace>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <WarnOnPackingNonPackableProject>false</WarnOnPackingNonPackableProject>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <!-- Embedded pdb seems to be incompatible with `dotnet pack`. -->
        <DebugType>portable</DebugType>
        <RollForward>Major</RollForward>
    </PropertyGroup>

    <!-- This project is the executable of the worker of Metalama. The worker itself is the Metalama.Backstage.Core.Worker
         library; this project binds it to the Metalama product and packages it as the zip archive that
         Metalama.Backstage.Tools embeds. -->

    <Import Project="$(MetalamaBackstageDirectory)\Metalama.Backstage.Common.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UseAppHost>false</UseAppHost>
        <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
        <!-- This app should run on any .NET 6+ runtime. -->
        <RollForward>Major</RollForward>
        <OutputZipFile>bin\$(MSBuildProjectName).zip</OutputZipFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Metalama.Backstage\Metalama.Backstage.csproj" />
        <ProjectReference Include="..\Metalama.Backstage.Core.Worker\Metalama.Backstage.Core.Worker.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Remove="Properties\launchSettings.json" />
    </ItemGroup>

    <Import Project="../../../eng/DeterministicZip.tasks"/>

    <Target Name="PackAndZip" AfterTargets="Build">

        <!-- We need to create a web archive that contains static assets. The directory is deleted first, so that the
             archive does not carry the files of an earlier build. -->
        <RemoveDir Directories="$(OutputPath)Packed" />
        <Exec Command="dotnet publish $(ProjectPath) --no-build -o $(OutputPath)Packed -c $(Configuration)" />

        <ItemGroup>
            <ZipInputFiles Include="$(OutputPath)Packed\**\*" />
        </ItemGroup>

        <CreateDeterministicZip SourceDirectory="$(OutputPath)Packed" DestinationFile="$(OutputZipFile)" PackageBuildDate="$(MetalamaBuildDate)" />
        <Message Text="$(MSBuildProjectName) -&gt; $(MSBuildProjectDirectory)\$(OutputZipFile)" Importance="High" />
    </Target>

</Project>
