<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <RollForward>Major</RollForward>
        <Nullable>enable</Nullable>
        <UseWPF>true</UseWPF>
        <EnableWindowsTargeting>True</EnableWindowsTargeting>
        <RootNamespace>Metalama.Backstage.Desktop.Windows</RootNamespace>
        <PackageDescription>The desktop notifier of Metalama.Backstage for Windows as a library: the toast notifications and the browser window. A product hosts it in a small executable. This package should only be installed as a dependency.</PackageDescription>
    </PropertyGroup>

    <!-- It seems the WinRT source generator runs when it shouldn't and causes bogus warnings, see https://github.com/dotnet/sdk/issues/44026, so we disable it. -->
    <!-- This can be removed once that bug is fixed. -->
    <Target Name="DisableWinRTSourceGenerator" BeforeTargets="CoreCompile">
        <ItemGroup>
            <Analyzer Remove="@(Analyzer)"
                      Condition="'%(FileName)%(Extension)' == 'WinRT.SourceGenerator.dll'"/>
        </ItemGroup>
    </Target>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" />
        <PackageReference Include="Microsoft.Web.WebView2" />
        <PackageReference Include="Spectre.Console.Cli" />
        <PackageReference Include="Newtonsoft.Json" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Metalama.Backstage.Core\Metalama.Backstage.Core.csproj"/>
    </ItemGroup>

    <!-- The logos of every product family are shipped with the library and copied next to the executable of the
         product, which selects one of them by ProductProfile.LogoName. -->
    <ItemGroup>
        <None Remove="Resources\metalama.png"/>
        <None Remove="Resources\postsharp.png"/>
        <Content Include="Resources\metalama.png;Resources\postsharp.png">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>contentFiles\any\any\Resources\;content\Resources\</PackagePath>
            <PackageCopyToOutput>true</PackageCopyToOutput>
        </Content>
    </ItemGroup>

</Project>
