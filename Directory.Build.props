<Project>
    <PropertyGroup>
        <SuppressNETCoreSdkPreviewMessage>True</SuppressNETCoreSdkPreviewMessage>

        <!-- Disabling new features while the SDK is not stable:
           - IDE0032: change to automatic property (with field keyword)
           - IDE0031: simplify null-conditional assignment
        -->
        <NoWarn>$(NoWarn);IDE0032;IDE0031</NoWarn>

        <!-- A template is compiled by the Roslyn of the host, so the language version we may use in templates and
             in build-time code is bounded by the lowest Roslyn version that a host in the supported set presents.
             That version is RoslynApiMinVersion in Directory.Packages.props. It is 5.0.0, which supports C# 14.
             Raise this value only together with that one, and read Metalama.Framework/docs/platform-support.md
             first, because the platform baseline is what decides the floor. -->
        <MetalamaTemplateLanguageVersion>14.0</MetalamaTemplateLanguageVersion>

        <!-- The rules of the [Durable] contract, LAMA0870 to LAMA0879, report objects that the design-time pipeline
             keeps beyond the run that produced them and that hold something which cannot be shown to be durable. They
             are a survey rather than a list of defects, and each one that remains is recorded and deliberate.

             CodeQuality.targets sets TreatWarningsAsErrors when ContinuousIntegrationBuild is true, which would turn
             that survey into a broken build. They are kept as warnings so that they stay visible without stopping the
             build. Remove this line once the findings are resolved, so that a new one cannot be introduced silently. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);LAMA0870;LAMA0871;LAMA0872;LAMA0873;LAMA0874;LAMA0875;LAMA0876;LAMA0877;LAMA0878;LAMA0879</WarningsNotAsErrors>

        <!-- The rules of the [ImmutableType] contract, LAMA0880 to LAMA0889, report aspects, fabrics and validators
             that are not written in an immutable style. An aspect is instantiated once and reused for every target it
             applies to, so state kept on it leaks from one target to the next.

             They are kept as warnings for the same reason as the durability rules above: CodeQuality.targets sets
             TreatWarningsAsErrors when ContinuousIntegrationBuild is true, and the campaign that resolves these
             findings is not finished. Remove this line once they are resolved, so that a new one cannot be introduced
             silently. -->
        <WarningsNotAsErrors>$(WarningsNotAsErrors);LAMA0880;LAMA0881;LAMA0882;LAMA0883;LAMA0884;LAMA0885;LAMA0886;LAMA0887;LAMA0888;LAMA0889</WarningsNotAsErrors>

    </PropertyGroup>
</Project>