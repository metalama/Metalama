<Project>
    <!--
        The items are not registered when ContinuousIntegrationBuild is True, because DiffEngine does not launch a diff tool on a
        build server, and loading the extension assemblies for each test costs time. Set MetalamaEnableDiffEngine to True to
        register them in this case too, or to False to never register them. MSBuild evaluates items after all properties, so
        both properties can be set anywhere, including after this file is imported.
    -->
    <ItemGroup Condition="'$(MetalamaEnableDiffEngine)' == 'True' Or ('$(MetalamaEnableDiffEngine)' == '' And '$(ContinuousIntegrationBuild)' != 'True')">
        <!-- Load DiffEngine dependencies first -->
        <MetalamaExtensionAssembly Include="$(MSBuildThisFileDirectory)../metalama/net472/EmptyFiles.dll" TargetFramework="net472" />
        <MetalamaExtensionAssembly Include="$(MSBuildThisFileDirectory)../metalama/net10.0/EmptyFiles.dll" TargetFramework="net10.0" />
        <MetalamaExtensionAssembly Include="$(MSBuildThisFileDirectory)../metalama/net472/DiffEngine.dll" TargetFramework="net472" />
        <MetalamaExtensionAssembly Include="$(MSBuildThisFileDirectory)../metalama/net10.0/DiffEngine.dll" TargetFramework="net10.0" />
        <!-- Then load the extension assembly -->
        <MetalamaExtensionAssembly Include="$(MSBuildThisFileDirectory)../metalama/net472/Metalama.Extensions.DiffEngine.dll" TargetFramework="net472" />
        <MetalamaExtensionAssembly Include="$(MSBuildThisFileDirectory)../metalama/net10.0/Metalama.Extensions.DiffEngine.dll" TargetFramework="net10.0" />
        <!-- Register the test plugin -->
        <MetalamaTestPlugIn Include="Metalama.Extensions.DiffEngine.DiffEngineRunner, Metalama.Extensions.DiffEngine" />
    </ItemGroup>
</Project>
