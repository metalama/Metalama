<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>Metalama.Framework.CompilerExtensions</RootNamespace>
        <IsPackable>False</IsPackable>

        <!-- Disable vulnerability checking because this project is not surfacing. -->
        <NuGetAudit>false</NuGetAudit>

    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynApiMinVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="$(RoslynApiMinVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RoslynApiMinVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" VersionOverride="$(RoslynApiMinVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <!-- The classification of the host process is merged into this assembly, because the copy merged into
             Metalama.Framework.CompilerExtensions is internal to that assembly. See ILMergePackages.targets. -->
        <PackageReference Include="SharpCrafters.Backstage.ProcessClassification" PrivateAssets="all" ILMerge="true" />
        <PackageReference Include="SharpCrafters.Backstage.Abstractions" PrivateAssets="all" ILMerge="true" />
    </ItemGroup>

    <Import Project="../ILMergePackages.targets" />

    <ItemGroup>
        <ProjectReference Include="../Metalama.Framework.CompilerExtensions/Metalama.Framework.CompilerExtensions.csproj"/>
        <Compile Include="..\Metalama.Framework.CompilerExtensions\ProcessKindHelper.cs" Link="ProcessKindHelper.cs" />
		<Compile Include="..\Metalama.Framework.DesignTime\RoslynEntryPointTypeNames.cs" Link="RoslynEntryPointTypeNames.cs" />
    </ItemGroup>

</Project>
