<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
        <PackageId>Metalama.Framework.Redist</PackageId>
        <PackageDescription>
            Redistributable components for package 'Metalama.Framework'. This package should only be installed as a dependency.
            (This is not the package you are looking for.)
        </PackageDescription>
        
        <IsPackable>True</IsPackable>
    </PropertyGroup>
    
    <ItemGroup>
        <InternalsVisibleTo Include="Metalama.Framework.Sdk" />
        
        <InternalsVisibleTo Include="Metalama.Framework.Engine.5.0.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Engine.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.AspectTests.5.0.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.AspectTests.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.UnitTests.5.0.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.UnitTests.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.UnitTestHelpers.5.0.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.UnitTestHelpers.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.TemplateTests.5.0.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.TemplateTests.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.LinkerTests.5.0.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.LinkerTests.5.10.0" />
        
        <InternalsVisibleTo Include="Metalama.Roslyn" />
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="$(FakeItEasyKey)" LoadsWithinVisualStudio="false" />
    </ItemGroup>
    
    <ItemGroup>
        <!-- The contract assembly declares both markers and several of the types they bind. DurableLazy<T> is itself
             marked [Durable], and IAspect, Fabric, IExpression, IType and the strategy interfaces are marked
             [ImmutableType], so the analyzer verifies this assembly against the two contracts it defines. -->
        <ProjectReference Include="../Metalama.Framework.Analyzers/Metalama.Framework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CSharp"/>

        <PackageReference Include="Microsoft.Bcl.HashCode" Condition="'$(TargetFramework)'=='netstandard2.0'" />

        <!-- Supplies IAsyncEnumerable<T>, IAsyncEnumerator<T> and the async iterator state machine types, which the
             netstandard2.0 target framework does not have. The Metalama.Framework.RunTime helpers that buffer an async
             iterator are compiled for netstandard2.0 as well, because a project targeting netstandard2.0, net472,
             net8.0 or net9.0 resolves the netstandard2.0 asset of this package. -->
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Condition="'$(TargetFramework)'=='netstandard2.0'" />

        <!-- We are stuck with a low version of System.Collections.Immutable because our code needs to run with Roslyn 4.0. -->
        <PackageReference Include="System.Collections.Immutable" />
    </ItemGroup>

    <!-- Packaging -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

</Project>
