<Project>
    <!-- TODO: somehow also set PrivateAssets for aspect libraries -->
    <ItemGroup>
        <PackageReference Update="Metalama.Framework" PrivateAssets="none"/>
        <PackageReference Update="Metalama.Framework.Sdk" PrivateAssets="none"/>
    </ItemGroup>

    <PropertyGroup>
        <MetalamaEnabled Condition="'$(MetalamaEnabled)'==''">True</MetalamaEnabled>

        <!-- Set to 'False' to turn off the checks of the target framework, the .NET SDK and the Visual Studio version. -->
        <MetalamaCheckSupportedPlatform Condition="'$(MetalamaCheckSupportedPlatform)'==''">True</MetalamaCheckSupportedPlatform>
    </PropertyGroup>

    <!--
        The platform matrix that Metalama.Framework supports. Any other package, or the project itself, can
        declare its own MetalamaPlatformRequirement item in a .props file. Every metadata entry is optional, an absent
        entry means no constraint, and unknown metadata is ignored. See
        https://doc.metalama.net/conceptual/configuration/msbuild-properties.

        Maintainers: these values are the PB-2027.0 platform baseline. Keep them in sync with
        Metalama.Framework/docs/platform-support.md, which is where that baseline is defined.
    -->
    <ItemGroup>
        <MetalamaPlatformRequirement Include="Metalama.Framework">
            <TargetFrameworkIdentifiers>.NETFramework;.NETCoreApp;.NETStandard</TargetFrameworkIdentifiers>
            <MinimumNETFrameworkVersion>4.7.2</MinimumNETFrameworkVersion>
            <MinimumNETStandardVersion>2.0</MinimumNETStandardVersion>
            <MaximumNETStandardVersion>2.1</MaximumNETStandardVersion>
            <MinimumNETCoreAppVersion>10.0</MinimumNETCoreAppVersion>
            <MaximumNETCoreAppVersion>11.0</MaximumNETCoreAppVersion>
            <MinimumSdkVersion>10.0</MinimumSdkVersion>
            <MaximumSdkVersion>11.0</MaximumSdkVersion>
            <!-- PB-2027.0 excludes Visual Studio 2022 entirely, so the floor is Visual Studio 2026, whose MSBuild is
                 18.0. The baseline names the November 2026 long-term servicing channel as the floor; its feature band
                 is measured after 2026-11-10, per the checklist of platform-support.md, and raises this value then. -->
            <MinimumVisualStudioVersion>18.0</MinimumVisualStudioVersion>
            <SupportedTargetFrameworksDescription>The supported target frameworks are .NET Framework 4.7.2 and later, .NET Standard 2.0 and 2.1, .NET 10 and .NET 11.</SupportedTargetFrameworksDescription>
            <SupportedSdkVersionsDescription>The supported .NET SDK versions are 10.0 and 11.0.</SupportedSdkVersionsDescription>
            <SdkUpgradeDescription>Install the .NET 10 SDK or a later one, which Visual Studio 2026 also carries. A 'global.json' file may pin an older SDK after a newer one has been installed.</SdkUpgradeDescription>
            <SupportedVisualStudioVersionsDescription>The supported versions are Visual Studio 2026 and later. Visual Studio 2022 is not supported.</SupportedVisualStudioVersionsDescription>
            <HelpLink>https://doc.metalama.net/conceptual/configuration/msbuild-properties</HelpLink>
        </MetalamaPlatformRequirement>
    </ItemGroup>

    <Import Project="Metalama.CompilerVisibleProperties.props"
            Condition="'$(MetalamaCompilerVisiblePropertiesTargetsImported)'==''"/>

    <!-- Implementation of the 'LamaDebug' build configuration.
         It is import to define this in the .props file, and not in the .targets file, because it needs to be processed _before_
         Metalama.Compiler targets file. -->
    
    <PropertyGroup Condition="'$(Configuration)'=='LamaDebug'">
        <MetalamaDebugTransformedCode>True</MetalamaDebugTransformedCode>

        <!-- Defaults from .NET SDK -->
        <DebugSymbols Condition="'$(DebugSymbols)' == ''">true</DebugSymbols>
        <Optimize Condition="'$(Optimize)' == ''">false</Optimize>
        <MetadataUpdaterSupport Condition="'$(MetadataUpdaterSupport)' == ''">true</MetadataUpdaterSupport>
        <XamlDebuggingInformation Condition="'$(XamlDebuggingInformation)' == ''">true</XamlDebuggingInformation>
        <_SGenGenerateSerializationAssembliesConfig Condition="'$(_SGenGenerateSerializationAssembliesConfig)' == 'Auto'">Off</_SGenGenerateSerializationAssembliesConfig>
        <DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>

    </PropertyGroup>

    <ItemGroup>
        <!-- Source generator attributes targeting members present in .Net 9 (dotnet/runtime and dotnet/extensions): -->
        <MetalamaSourceGeneratorAttribute Include="Microsoft.Extensions.Diagnostics.Metrics.CounterAttribute" />
        <MetalamaSourceGeneratorAttribute Include="Microsoft.Extensions.Diagnostics.Metrics.GaugeAttribute" />
        <MetalamaSourceGeneratorAttribute Include="Microsoft.Extensions.Diagnostics.Metrics.HistogramAttribute" />
        <MetalamaSourceGeneratorAttribute Include="Microsoft.Extensions.Logging.LoggerMessageAttribute" />
        <MetalamaSourceGeneratorAttribute Include="System.Runtime.InteropServices.JavaScript.JSExportAttribute" />
        <MetalamaSourceGeneratorAttribute Include="System.Runtime.InteropServices.JavaScript.JSImportAttribute" />
        <MetalamaSourceGeneratorAttribute Include="System.Runtime.InteropServices.LibraryImportAttribute" />
        <MetalamaSourceGeneratorAttribute Include="System.Text.RegularExpressions.GeneratedRegexAttribute" />

        <!-- ASP.NET Core 9 (dotnet/aspnetcore) does not ship any attribute-based source generators. -->
    </ItemGroup>

    <ItemGroup>
        <MetalamaTransformedCodeAnalyzer Include="Metalama.Framework.CompilerExtensions.MetalamaGeneratedCodeAnalyzer" />
    </ItemGroup>

  
</Project>