<Project>

    <!--
        Define a METALAMA_PROJECT_<hash> compilation symbol that identifies this project. Metalama identifies a project
        by its assembly name and by a hash of its compilation symbols, because those are the only project-identifying
        data available from a Compilation alone. Without this symbol, two projects that have the same assembly name and
        the same target framework are indistinguishable. See https://github.com/metalama/Metalama/issues/1749.

        The identifier is the path of the project relative to MetalamaRootDirectory, which defaults to the directory of
        the solution. A relative path keeps the symbol, and therefore the compilation, independent of the directory into
        which the repository is cloned, which a build that must be reproducible requires. Set MetalamaRootDirectory
        explicitly when the same project is built from several solutions and must produce the same symbol in each.

        This is defined even when MetalamaEnabled is False. The symbol has no effect on the compilation of the project
        itself, and a project that Metalama does not process is still referenced by projects that it does process, which
        identify it by the same key.
    -->
    <PropertyGroup>
        <MetalamaRootDirectory Condition="'$(MetalamaRootDirectory)'==''">$(SolutionDir)</MetalamaRootDirectory>

        <_MetalamaProjectPath Condition="'$(MetalamaRootDirectory)'!=''">$([MSBuild]::MakeRelative('$(MetalamaRootDirectory)', '$(MSBuildProjectFullPath)'))</_MetalamaProjectPath>
        <!-- Without a root directory there is no stable path to be relative to, so only the file name of the project is
             used. Two projects that have the same file name and the same assembly name then share an identifier. -->
        <_MetalamaProjectPath Condition="'$(MetalamaRootDirectory)'==''">$(MSBuildProjectFile)</_MetalamaProjectPath>

        <!-- The directory separator is normalized so that the same project yields the same symbol on every platform.
             The spaces of the platform are removed, because a solution configuration names it 'Any CPU' whereas a
             project names it 'AnyCPU', and the identifier of a project must not depend on which of the two the host
             happens to evaluate. -->
        <_MetalamaNormalizedProjectPath>$(_MetalamaProjectPath.Replace('\','/'))</_MetalamaNormalizedProjectPath>
        <_MetalamaNormalizedPlatform>$(Platform.Replace(' ',''))</_MetalamaNormalizedPlatform>
        <_MetalamaProjectId>$(_MetalamaNormalizedProjectPath)|$(TargetFramework)|$(Configuration)|$(_MetalamaNormalizedPlatform)</_MetalamaProjectId>

        <!-- The hash is computed in two steps because MSBuild cannot parse a property function nested inside the quoted
             argument of another one (MSB4186). The hash is signed, and 'N' replaces the minus sign so that the symbol
             remains a valid identifier.

             StableStringHash is 32 bits, so two projects of one solution can collide, with the probability of the
             birthday problem: roughly one in a million for a solution of a hundred projects. A collision is not silent:
             the design-time pipeline compares the path, the target framework and the configuration of the two projects
             before serving a cached pipeline, and reports the collision instead of serving the wrong one. The wider
             overload of StableStringHash is not used, because it is not available in every supported version of
             MSBuild. -->
        <_MetalamaProjectIdHash>$([MSBuild]::StableStringHash('$(_MetalamaProjectId)'))</_MetalamaProjectIdHash>
        <_MetalamaProjectDiscriminator>$([System.String]::Copy('$(_MetalamaProjectIdHash)').Replace('-','N'))</_MetalamaProjectDiscriminator>
        <DefineConstants>$(DefineConstants);METALAMA_PROJECT_$(_MetalamaProjectDiscriminator)</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(MetalamaEnabled)'!='False'">
        <!-- Define a METALAMA compilation symbol (aka constant). -->
        <DefineConstants>$(DefineConstants);METALAMA</DefineConstants>

        <!-- Auxiliary files used at design time. -->
        <MetalamaAdditionalCompilationOutputDirectory Condition="'$(MetalamaDesignTimeEnabled)'=='False'">$(MSBuildProjectDirectory)/$(IntermediateOutputPath)/metalama-aux/</MetalamaAdditionalCompilationOutputDirectory>

        <!-- Design time fallback dependency that forces rerun of analyzers/source generators when changed. -->
        <MetalamaDesignTimeFallbackTouchFile Condition="'$(MetalamaDesignTimeEnabled)'=='False'">$(MetalamaAdditionalCompilationOutputDirectory)MetalamaDesignTimeTouch.touch</MetalamaDesignTimeFallbackTouchFile>

        <!-- Define a new build configuration named LamaDebug (configured below).
             This needs to be done in the targets file, and not in the props file, because Microsoft.NET.Sdk.props will not define it if we define it first in our own props file. -->
        <Configurations Condition="'$(MetalamaCreateLamaDebugConfiguration)'!='False'">$(Configurations);LamaDebug</Configurations>

        <!-- If this is a compile-time project, do not remove compile-time-only code. -->
        <MetalamaRemoveCompileTimeOnlyCode Condition="'$(MetalamaCompileTimeProject)'=='True'">False</MetalamaRemoveCompileTimeOnlyCode>

        <!-- Convert items to properties -->
        <!-- We use ',' as a list item separator and '|' as a separator within a list. We don't use ';' because it means a comment in .editorconfig -->
        <MetalamaCompileTimePackages>@(MetalamaCompileTimePackage, ',')</MetalamaCompileTimePackages>
        <MetalamaCompileTimeAssemblies>@(MetalamaCompileTimeAssembly -> '%(FullPath)', ',')</MetalamaCompileTimeAssemblies>
        <MetalamaSourceGeneratorAttributes>@(MetalamaSourceGeneratorAttribute, ',')</MetalamaSourceGeneratorAttributes>
        <MetalamaExtensionAssemblies>@(MetalamaExtensionAssembly -> '%(FullPath)|%(TargetFramework)|%(TargetRoslynVersion)', ',')</MetalamaExtensionAssemblies>
        <MetalamaDesignTimeExtensionAssemblies>@(MetalamaDesignTimeExtensionAssembly -> '%(FullPath)|%(TargetFramework)|%(TargetRoslynVersion)', ',')</MetalamaDesignTimeExtensionAssemblies>

        <!-- Normalize the separator of the following property for the same reason. Unlike the properties above, it is
             written by the user, who naturally separates target frameworks with the ';' that is customary in MSBuild.
             Left as such, everything after the first ';' would be read as a comment and silently dropped. See #1789. -->
        <MetalamaCompileTimeTargetFrameworks Condition="'$(MetalamaCompileTimeTargetFrameworks)'!=''">$(MetalamaCompileTimeTargetFrameworks.Replace(';', ','))</MetalamaCompileTimeTargetFrameworks>

        <!-- Elevating CS8032: An instance of analyzer X cannot be created. 
             We elevate this warning to an error because otherwise, if Metalama.Framework fails to load, the compilation will be incorrect while there
             will be no warning. Troubleshooting this issue may be very complex without a real error.     -->
        <WarningsAsErrors>$(WarningsAsErrors);CS8032</WarningsAsErrors>

    </PropertyGroup>

    <!-- Default MetalamaFormatOutput to True when MetalamaDebugTransformedCode is True.
         This must be in the .targets file (not .props) so it can see properties set in the project file. -->
    <PropertyGroup Condition="'$(MetalamaDebugTransformedCode)'=='True'">
        <MetalamaFormatOutput Condition="'$(MetalamaFormatOutput)'==''">True</MetalamaFormatOutput>
    </PropertyGroup>

    <!-- For WPF projects, default IncludePackageReferencesDuringMarkupCompilation to true so that
         Metalama runs in the temporary assembly that MarkupCompilePass1 builds via
         GenerateTemporaryTargetAssembly. Without this, the temp compile excludes PackageReferences
         (and therefore Metalama analyzers/targets), so XAML references to aspect-introduced members
         fail with CS0117/CS1061, which cascades into MC3074. The known tradeoff is that the
         Metalama pipeline runs twice per WPF build (once in the temp compile, once in the real
         one); this matches the default modern .NET SDK WPF projects already use. The default
         is user-overridable, but an explicit false is rejected by MetalamaCheckMarkupCompilation
         (below) since it is incompatible with Metalama in a WPF project.
         See https://github.com/metalama/Metalama/issues/1588. -->
    <PropertyGroup Condition="'$(UseWPF)'=='true' AND '$(MetalamaEnabled)'!='False'">
        <IncludePackageReferencesDuringMarkupCompilation Condition="'$(IncludePackageReferencesDuringMarkupCompilation)'==''">true</IncludePackageReferencesDuringMarkupCompilation>
    </PropertyGroup>

    <!-- Inside the WPF MarkupCompilePass1 temporary assembly (project name suffix _wpftmp), switch Metalama
         to the WpfPrecompile compilation scenario. The pipeline then emits aspect-introduced member signatures
         only and skips the linker, since the temp assembly is consumed only by the XAML compiler for type
         resolution and then discarded. The full linker still runs in the real compile pass that follows.
         The user can override by setting MetalamaCompilationScenario explicitly. See https://github.com/metalama/Metalama/issues/1590. -->
    <PropertyGroup Condition="'$(UseWPF)'=='true' AND '$(MetalamaEnabled)'!='False' AND '$(MetalamaCompilationScenario)'==''">
        <MetalamaCompilationScenario Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">WpfPrecompile</MetalamaCompilationScenario>
    </PropertyGroup>

      <!-- The LangVersionImplicitlySet property is set by Metalama.Compiler when LangVersion is not defined, according to the current target framework.
         We change this value to our own lowest supported version. 
        -->
    <PropertyGroup Condition="'$(LangVersionImplicitlySet)'=='True' AND '$(LangVersion)'!='12.0' AND '$(LangVersion)'!='13.0' AND '$(LangVersion)'!='14.0' AND '$(LangVersion)'!='default' AND '$(LangVersion)'!='latest' AND '$(LangVersion)'!='latestMajor' AND '$(LangVersion)'!='preview'">
        <_LangVersionBeforeMetalamaFix>$(LangVersion)</_LangVersionBeforeMetalamaFix>
        <LangVersion>12.0</LangVersion>
    </PropertyGroup>





    <ItemGroup Condition="'$(MetalamaCompileTimeProject)'=='True'">
        <AssemblyAttributes Include="Metalama.Framework.Aspects.CompileTimeAttribute"/>
    </ItemGroup>

    <ItemGroup Condition="'$(DesignTimeBuild)' == 'True' AND '$(MetalamaDesignTimeEnabled)'=='False'">
        <AdditionalFiles Include="$(MetalamaDesignTimeFallbackTouchFile)" Visible="False" />
    </ItemGroup>

    <Target Name="GetRestoreSources" BeforeTargets="PrepareForBuild" DependsOnTargets="_GetRestoreSettings" Condition="$(IsRestoreTargetsFileLoaded)=='true'">
        <PropertyGroup>
            <MetalamaRestoreSources>$(_OutputSources)</MetalamaRestoreSources>
        </PropertyGroup>
    </Target>

    <!-- Both touch files live under $(IntermediateOutputPath) so they are TFM-specific. Multi-targeted
         projects build their TFMs in parallel; sharing a single file across TFMs (as we briefly did under
         $(BaseIntermediateOutputPath) for the source-generator touch file) causes MSB3371 file-lock
         collisions. See https://github.com/metalama/Metalama/issues/1597.
         If $(IntermediateOutputPath) is undefined (e.g. when the .NET SDK has not yet resolved), the
         path properties stay empty and CreateMetalamaTouchFiles is skipped — IProjectOptions
         tolerates a null SourceGeneratorTouchFile/BuildTouchFile. -->
    <Target Name="ExportMetalamaFrameworkProperties" BeforeTargets="PrepareForBuild" Condition="'$(IntermediateOutputPath)'!=''">
        <PropertyGroup>
            <MetalamaBuildTouchFile>$([System.IO.Path]::Combine($(MSBuildProjectDirectory),$(IntermediateOutputPath),'MetalamaBuild.touch'))</MetalamaBuildTouchFile>
            <MetalamaSourceGeneratorTouchFile>$([System.IO.Path]::Combine($(MSBuildProjectDirectory),$(IntermediateOutputPath),'MetalamaSourceGenerator.g.cs'))</MetalamaSourceGeneratorTouchFile>
        </PropertyGroup>
    </Target>

    <Target Name="CreateMetalamaTouchFiles" BeforeTargets="BeforeCompile" Condition="'$(MetalamaBuildTouchFile)'!='' AND '$(MetalamaSourceGeneratorTouchFile)'!=''">
        <!-- MetalamaBuildTouchFile signals the design-time pipeline that a build has started. The design-time
             pipeline deletes it when it has observed a source change; AlwaysCreate without overwrite preserves
             incremental builds. It is registered as <AdditionalFiles> only so the compiler picks up its
             existence — the pipeline observes it through its own filesystem watcher, not through Roslyn. -->
        <Touch Files="$(MetalamaBuildTouchFile)" AlwaysCreate="true"/>

        <!-- MetalamaSourceGeneratorTouchFile is a .cs file included in <Compile> whose TouchId GUID the
             design-time pipeline rewrites whenever it produces a new compilation. Using <Compile> rather than
             <AdditionalFiles> ensures Rider and VS observe the change (see RIDER-75959, dotnet/roslyn#74716,
             https://github.com/metalama/Metalama/issues/831) and rerun the source generator. The class is
             [Obsolete(..., true)] so user code cannot reference it — that prevents any name collision when two
             projects share internals via [InternalsVisibleTo].

             The stub written below is the minimal valid syntax tree that satisfies the compiler on the very
             first design-time build (before the pipeline has run); the pipeline then overwrites it with the
             canonical multi-line form on every run. The task uses Overwrite="true", but Condition="!Exists(...)"
             ensures it only creates the file when it is missing, so subsequent passes do not touch the
             pipeline's content during multi-pass builds (restore + build, WPF MarkupCompilePass1 temp +
             real, design-time + real). The first line is // <auto-generated /> so user analyzers and style
             rules skip it; ';' inside the namespace line is escaped as '%3B' so MSBuild does not split the
             Lines value on it, while the literal ';' between the two lines is the MSBuild list separator
             that produces the line break. -->
        <WriteLinesToFile File="$(MetalamaSourceGeneratorTouchFile)"
                          Lines="// &lt;auto-generated /&gt;;namespace Metalama.Internal { [global::System.Obsolete(&quot;Design-time only. Do not reference.&quot;, true)] internal static class MetalamaSourceGeneratorMarker { public const string TouchId = &quot;&quot;%3B } }"
                          Overwrite="true"
                          Condition="!Exists('$(MetalamaSourceGeneratorTouchFile)')"/>

        <ItemGroup>
            <AdditionalFiles Include="$(MetalamaBuildTouchFile)" Visible="False"/>
            <!-- Only include the marker as <Compile> during design-time builds. The marker exists to make
                 Rider/Roslyn re-run the source generator when the design-time pipeline rewrites its TouchId
                 GUID; real (non-design-time) builds have no use for it, and embedding the fluctuating GUID
                 into the produced assembly's metadata would break deterministic builds. The Clean entry
                 below stays unconditional so the file is removed regardless of build kind. -->
            <Compile Include="$(MetalamaSourceGeneratorTouchFile)" Visible="False" Condition="'$(DesignTimeBuild)'=='True'"/>
            <Clean Include="$(MetalamaBuildTouchFile)"/>
            <Clean Include="$(MetalamaSourceGeneratorTouchFile)"/>
        </ItemGroup>
    </Target>

    <!-- Exports the assembly names of the references that come from a ProjectReference, i.e. of the other projects
         of the same solution. Metalama needs the distinction to warn about mixing Metalama versions within a
         solution: a reference to an assembly built by another Metalama version is normal when it is a package, and is
         only a problem when it is a sibling project. ProjectReference is a design-time concept, so by the time the
         compiler runs every reference is a PortableExecutableReference and the distinction is lost;
         ResolveAssemblyReferences has already computed it as %(ReferenceSourceTarget).

         Assembly names and not paths: the consumer compares them against the assembly identity it reads from the
         reference, which is robust, whereas a path has to match exactly across two subsystems. That comparison used
         to fail silently, because when the referenced project produces a reference assembly (the default) the
         compiler is given the reference assembly under 'obj\<config>\<tfm>\ref\X.dll' while @(ReferencePath) still holds
         'bin\<config>\<tfm>\X.dll'. Names also cannot contain the ',' that separates the list items, so they need
         no escaping. -->
    <Target Name="ExportMetalamaProjectReferences" BeforeTargets="GenerateMSBuildEditorConfigFileCore" DependsOnTargets="ResolveAssemblyReferences">
        <ItemGroup>
            <_MetalamaProjectReference Include="@(ReferencePath)" Condition="'%(ReferencePath.ReferenceSourceTarget)'=='ProjectReference'"/>
        </ItemGroup>
        <PropertyGroup>
            <MetalamaProjectReferenceNames>@(_MetalamaProjectReference->'%(Filename)', ',')</MetalamaProjectReferenceNames>
        </PropertyGroup>
    </Target>

    <Target Name="GatherCompilerVisibleProperties" BeforeTargets="GenerateMSBuildEditorConfigFileCore" DependsOnTargets="ExportMetalamaProjectReferences">
        <!-- This is only required for Roslyn 4.0, which doesn't have AnalyzerConfigOptions.Keys. -->
        <PropertyGroup>
            <MetalamaCompilerVisiblePropertiesList>@(CompilerVisibleProperty, ',')</MetalamaCompilerVisiblePropertiesList>
        </PropertyGroup>
        <ItemGroup>
            <CompilerVisibleProperty Include="MetalamaCompilerVisiblePropertiesList"/>
        </ItemGroup>
    </Target>

     <Target Name="CheckMetalamaAssemblyReferencePaths" BeforeTargets="BeforeCompile">
    
         <ItemGroup>
            <_InvalidPath Include="@(MetalamaCompileTimePackages)"  Condition="$([System.String]::Copy('%(FullPath)').Contains(`,`)) OR $([System.String]::Copy('%(FullPath)').Contains(`|`))" />
            <_InvalidPath Include="@(MetalamaCompileTimeAssemblies)"  Condition="$([System.String]::Copy('%(FullPath)').Contains(`,`)) OR $([System.String]::Copy('%(FullPath)').Contains(`|`))" />
            <_InvalidPath Include="@(MetalamaSourceGeneratorAttribute)"  Condition="$([System.String]::Copy('%(FullPath)').Contains(`,`)) OR $([System.String]::Copy('%(FullPath)').Contains(`|`))" />
            <_InvalidPath Include="@(MetalamaExtensionAssemblies)"  Condition="$([System.String]::Copy('%(FullPath)').Contains(`,`)) OR $([System.String]::Copy('%(FullPath)').Contains(`|`))" />
            <_InvalidPath Include="@(MetalamaDesignTimeExtensionAssemblies)" Condition="$([System.String]::Copy('%(FullPath)').Contains(`,`)) OR $([System.String]::Copy('%(FullPath)').Contains(`|`))" />
        </ItemGroup>

        <!-- Emit an error if there are invalid items -->
        <Error Text="The item '%(_InvalidPath.Identity)' has a FullPath containing an invalid character ('|' or ',')." 
            Condition="@(_InvalidPath->Count()) > 0" />
  </Target>

   <Target Name="MetalamaCheckLangVersion" BeforeTargets="CoreCompile">
    <Warning
      Text="The C# language version of the current project was updated from $(_LangVersionBeforeMetalamaFix) to $(LangVersion) despite the project targeting $(TargetFramework) because $(LangVersion) is the lowest version supported by Metalama Framework. To use C# $(LangVersion) features in $(TargetFramework), add a package like Polyfill. To suppress this warning, set &lt;LangVersion&gt; to at least $(LangVersion) in your project file."
       Condition="'$(_LangVersionBeforeMetalamaFix)' != ''"
      />
  </Target>

  <!-- Reject IncludePackageReferencesDuringMarkupCompilation=false in WPF + Metalama projects.
       That setting excludes PackageReferences (and therefore Metalama) from the WPF MarkupCompilePass1
       temp assembly, so XAML references to aspect-introduced members fail with CS0117/CS1061 and
       cascade into MC3074. Failing fast with a clear error is friendlier than the cascading XAML errors. -->
  <Target Name="MetalamaCheckMarkupCompilation" BeforeTargets="MarkupCompilePass1">
    <Error
      Text="IncludePackageReferencesDuringMarkupCompilation is set to 'false' in a WPF project that uses Metalama. This excludes Metalama from the temporary assembly that WPF builds for MarkupCompilePass1, which causes XAML references to aspect-introduced members to fail. Remove the explicit 'false' (or set it to 'true') to let Metalama run in the temp compile."
      Condition="'$(UseWPF)'=='true' AND '$(MetalamaEnabled)'!='False' AND '$(IncludePackageReferencesDuringMarkupCompilation)'=='false'" />
  </Target>

  <!-- Reject the legacy Razor build (UseRazorSourceGenerator=false) in Metalama projects.
       The RazorCompileComponentDeclaration pass invokes the compiler without an /analyzerconfig, so none of
       Metalama's MSBuild configuration (extension assemblies, compile-time assemblies, user-code trust, language
       version, and so on) reaches the compiler. Metalama cannot run reliably in that pass. The Razor source
       generator, which is the default, does not have this limitation. Failing fast with a clear error is friendlier
       than the compiler crash or the silently incomplete output that would otherwise result.
       See https://github.com/metalama/Metalama/issues/1741. -->
  <Target Name="MetalamaCheckRazorComponentDeclaration" BeforeTargets="RazorCompileComponentDeclaration"
          Condition="'$(MetalamaEnabled)'!='False'">
    <Error
      Text="Metalama does not support the legacy Razor build that runs when the 'UseRazorSourceGenerator' property is set to 'false'. The 'RazorCompileComponentDeclaration' compilation pass does not provide Metalama with its configuration, so aspects cannot be applied reliably. Remove the 'UseRazorSourceGenerator' property (or set it to 'true') to use the Razor source generator, which is the default and is fully supported by Metalama." />
  </Target>

  <!--
       Reports a target framework, a .NET SDK or a Visual Studio version that is outside the platform matrix that
       Metalama supports. The matrix is the set of MetalamaPlatformRequirement items, which
       Metalama.Framework.props seeds and which any other package, or the project itself, can extend.

       One warning code per dimension, so that NoWarn can silence one dimension only: LAMA0600 for the target
       framework, LAMA0601 for the .NET SDK, LAMA0602 for the Visual Studio version. Every requirement of a dimension
       shares its code, so MetalamaSupportedPlatformExclusion is the way to silence a single requirement.

       Both targets are hooked before _CheckForInvalidConfigurationAndPlatform, rather than before CoreCompile, so that
       the warnings also appear in a design-time build. See https://github.com/metalama/Metalama/issues/1884.
  -->
  <Target Name="_MetalamaComputePlatformRequirements">

    <ItemGroup>
      <!-- Exclude matches on the item identity, which is the name of the package that the requirement speaks for. -->
      <_MetalamaPlatformRequirement Include="@(MetalamaPlatformRequirement)" Exclude="@(MetalamaSupportedPlatformExclusion)"/>

      <!-- The four sentences below are optional. Each one carries its own leading space, so that a requirement that
           omits one does not produce a message with two consecutive spaces. -->
      <_MetalamaPlatformRequirement>
        <TargetFrameworksSentence Condition="'%(_MetalamaPlatformRequirement.SupportedTargetFrameworksDescription)'!=''"> %(_MetalamaPlatformRequirement.SupportedTargetFrameworksDescription)</TargetFrameworksSentence>
        <SdkVersionsSentence Condition="'%(_MetalamaPlatformRequirement.SupportedSdkVersionsDescription)'!=''"> %(_MetalamaPlatformRequirement.SupportedSdkVersionsDescription)</SdkVersionsSentence>
        <SdkUpgradeSentence Condition="'%(_MetalamaPlatformRequirement.SdkUpgradeDescription)'!=''"> %(_MetalamaPlatformRequirement.SdkUpgradeDescription)</SdkUpgradeSentence>
        <VisualStudioVersionsSentence Condition="'%(_MetalamaPlatformRequirement.SupportedVisualStudioVersionsDescription)'!=''"> %(_MetalamaPlatformRequirement.SupportedVisualStudioVersionsDescription)</VisualStudioVersionsSentence>
      </_MetalamaPlatformRequirement>
    </ItemGroup>

  </Target>

  <!--
       The comparison uses $(TargetFrameworkIdentifier) and $(TargetFrameworkVersion) instead of a string comparison on
       $(TargetFramework). A string comparison neither recognizes 'net10.0-windows' as a form of 'net10.0', nor orders
       'v9.0' before 'v10.0'.

       This target runs once per target framework, because each inner build has its own target framework.
  -->
  <Target Name="MetalamaCheckSupportedTargetFramework"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform"
          DependsOnTargets="_MetalamaComputePlatformRequirements"
          Condition="'$(MetalamaEnabled)'!='False' AND '$(MetalamaCheckSupportedPlatform)'!='False' AND '$(TargetFrameworkIdentifier)'!=''">

    <PropertyGroup>
      <!-- $(TargetFrameworkVersion) is written 'v10.0', and the comparison functions need '10.0'. -->
      <_MetalamaTargetFrameworkVersion>$(TargetFrameworkVersion.TrimStart('vV'))</_MetalamaTargetFrameworkVersion>

      <_MetalamaSuppressionHint0600>The build continues, but a problem that is specific to this platform will not be fixed. To suppress this warning, set the 'MetalamaCheckSupportedPlatform' property to 'False', or add 'LAMA0600' to the 'NoWarn' property.</_MetalamaSuppressionHint0600>
    </PropertyGroup>

    <!-- A target framework identifier outside the declared list, for example MonoAndroid or UAP. The separators added
         on both sides make the search match a whole identifier rather than a prefix. -->
    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'%(_MetalamaPlatformRequirement.TargetFrameworkIdentifiers)'!='' AND !$([System.String]::Copy(';%(_MetalamaPlatformRequirement.TargetFrameworkIdentifiers);').Contains(';$(TargetFrameworkIdentifier);'))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)'.%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework' AND '%(_MetalamaPlatformRequirement.MinimumNETFrameworkVersion)'!='' AND $([MSBuild]::VersionLessThan($(_MetalamaTargetFrameworkVersion), %(_MetalamaPlatformRequirement.MinimumNETFrameworkVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)', which is older than .NET Framework %(_MetalamaPlatformRequirement.MinimumNETFrameworkVersion).%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(TargetFrameworkIdentifier)'=='.NETFramework' AND '%(_MetalamaPlatformRequirement.MaximumNETFrameworkVersion)'!='' AND $([MSBuild]::VersionGreaterThan($(_MetalamaTargetFrameworkVersion), %(_MetalamaPlatformRequirement.MaximumNETFrameworkVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)', which is newer than .NET Framework %(_MetalamaPlatformRequirement.MaximumNETFrameworkVersion). Check whether a newer version of '%(_MetalamaPlatformRequirement.Identity)' is available.%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(TargetFrameworkIdentifier)'=='.NETCoreApp' AND '%(_MetalamaPlatformRequirement.MinimumNETCoreAppVersion)'!='' AND $([MSBuild]::VersionLessThan($(_MetalamaTargetFrameworkVersion), %(_MetalamaPlatformRequirement.MinimumNETCoreAppVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)', which is older than .NET %(_MetalamaPlatformRequirement.MinimumNETCoreAppVersion).%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(TargetFrameworkIdentifier)'=='.NETCoreApp' AND '%(_MetalamaPlatformRequirement.MaximumNETCoreAppVersion)'!='' AND $([MSBuild]::VersionGreaterThan($(_MetalamaTargetFrameworkVersion), %(_MetalamaPlatformRequirement.MaximumNETCoreAppVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)', which is newer than .NET %(_MetalamaPlatformRequirement.MaximumNETCoreAppVersion). Check whether a newer version of '%(_MetalamaPlatformRequirement.Identity)' is available.%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(TargetFrameworkIdentifier)'=='.NETStandard' AND '%(_MetalamaPlatformRequirement.MinimumNETStandardVersion)'!='' AND $([MSBuild]::VersionLessThan($(_MetalamaTargetFrameworkVersion), %(_MetalamaPlatformRequirement.MinimumNETStandardVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)', which is older than .NET Standard %(_MetalamaPlatformRequirement.MinimumNETStandardVersion).%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(TargetFrameworkIdentifier)'=='.NETStandard' AND '%(_MetalamaPlatformRequirement.MaximumNETStandardVersion)'!='' AND $([MSBuild]::VersionGreaterThan($(_MetalamaTargetFrameworkVersion), %(_MetalamaPlatformRequirement.MaximumNETStandardVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the target framework '$(TargetFramework)', which is newer than .NET Standard %(_MetalamaPlatformRequirement.MaximumNETStandardVersion). Check whether a newer version of '%(_MetalamaPlatformRequirement.Identity)' is available.%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

    <!-- The comparison is case-insensitive, as every string comparison in an MSBuild condition is, so 'windows'
         matches the 'Windows' that the .NET SDK writes into $(TargetPlatformIdentifier). -->
    <Warning Code="LAMA0600"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'%(_MetalamaPlatformRequirement.RequiredTargetPlatformIdentifier)'!='' AND '$(TargetPlatformIdentifier)'!='%(_MetalamaPlatformRequirement.RequiredTargetPlatformIdentifier)'"
             Text="'%(_MetalamaPlatformRequirement.Identity)' requires a target framework of the '%(_MetalamaPlatformRequirement.RequiredTargetPlatformIdentifier)' platform, but this project targets '$(TargetFramework)'.%(_MetalamaPlatformRequirement.TargetFrameworksSentence) $(_MetalamaSuppressionHint0600)"/>

  </Target>

  <!--
       The .NET SDK and Visual Studio warnings below describe the toolchain rather than the project, so they are
       reported for the first target framework only. They cannot be reported from the outer build of a cross-targeting
       project, because NuGet imports the build folder of a package into the inner builds only.
  -->
  <PropertyGroup>
    <_MetalamaFirstTargetFramework Condition="'$(TargetFrameworks)'!=''">$(TargetFrameworks.Split(';')[0].Trim())</_MetalamaFirstTargetFramework>
  </PropertyGroup>

  <!--
       $(NETCoreSdkVersion) is empty in an old-style .NET Framework project built by msbuild.exe. The Visual Studio
       rule covers that configuration instead.

       $(MSBuildVersion), and not $(VisualStudioVersion), carries the Visual Studio feature band, so it is the only one
       of the two that can distinguish version 17.12 from version 17.14. The rule applies only when
       $(MSBuildRuntimeType) is 'Full', which means msbuild.exe. When it is 'Core', MSBuild comes from the .NET SDK and
       says nothing about Visual Studio.
  -->
  <Target Name="MetalamaCheckSupportedToolchain"
          BeforeTargets="_CheckForInvalidConfigurationAndPlatform"
          DependsOnTargets="_MetalamaComputePlatformRequirements"
          Condition="'$(MetalamaEnabled)'!='False' AND '$(MetalamaCheckSupportedPlatform)'!='False' AND ('$(_MetalamaFirstTargetFramework)'=='' OR '$(TargetFramework)'=='$(_MetalamaFirstTargetFramework)')">

    <PropertyGroup>
      <!-- The version of a preview SDK carries a prerelease suffix, for example '11.0.100-preview.1.26073.1', which has
           to be removed before the version is compared. -->
      <_MetalamaSdkVersion Condition="'$(NETCoreSdkVersion)'!=''">$(NETCoreSdkVersion.Split('-')[0])</_MetalamaSdkVersion>

      <_MetalamaSuppressionHint0601>The build continues, but a problem that is specific to this .NET SDK will not be fixed. To suppress this warning, set the 'MetalamaCheckSupportedPlatform' property to 'False', or add 'LAMA0601' to the 'NoWarn' property.</_MetalamaSuppressionHint0601>
      <_MetalamaSuppressionHint0602>The build continues, but a problem that is specific to this version of Visual Studio will not be fixed. To suppress this warning, set the 'MetalamaCheckSupportedPlatform' property to 'False', or add 'LAMA0602' to the 'NoWarn' property.</_MetalamaSuppressionHint0602>
    </PropertyGroup>

    <Warning Code="LAMA0601"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(_MetalamaSdkVersion)'!='' AND '%(_MetalamaPlatformRequirement.MinimumSdkVersion)'!='' AND $([MSBuild]::VersionLessThan($(_MetalamaSdkVersion), %(_MetalamaPlatformRequirement.MinimumSdkVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the .NET SDK $(NETCoreSdkVersion), which is older than %(_MetalamaPlatformRequirement.MinimumSdkVersion).%(_MetalamaPlatformRequirement.SdkVersionsSentence)%(_MetalamaPlatformRequirement.SdkUpgradeSentence) $(_MetalamaSuppressionHint0601)"/>

    <Warning Code="LAMA0601"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(_MetalamaSdkVersion)'!='' AND '%(_MetalamaPlatformRequirement.MaximumSdkVersion)'!='' AND $([MSBuild]::VersionGreaterThan($(_MetalamaSdkVersion), %(_MetalamaPlatformRequirement.MaximumSdkVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support the .NET SDK $(NETCoreSdkVersion), which is newer than %(_MetalamaPlatformRequirement.MaximumSdkVersion). Check whether a newer version of '%(_MetalamaPlatformRequirement.Identity)' is available.%(_MetalamaPlatformRequirement.SdkVersionsSentence) $(_MetalamaSuppressionHint0601)"/>

    <Warning Code="LAMA0602"
             HelpLink="%(_MetalamaPlatformRequirement.HelpLink)"
             Condition="'$(MSBuildRuntimeType)'=='Full' AND '$(MSBuildVersion)'!='' AND '%(_MetalamaPlatformRequirement.MinimumVisualStudioVersion)'!='' AND $([MSBuild]::VersionLessThan($(MSBuildVersion), %(_MetalamaPlatformRequirement.MinimumVisualStudioVersion)))"
             Text="'%(_MetalamaPlatformRequirement.Identity)' does not support MSBuild $(MSBuildVersion), which is older than %(_MetalamaPlatformRequirement.MinimumVisualStudioVersion) and therefore belongs to a version of Visual Studio older than the oldest supported one.%(_MetalamaPlatformRequirement.VisualStudioVersionsSentence) $(_MetalamaSuppressionHint0602)"/>

  </Target>

</Project>
