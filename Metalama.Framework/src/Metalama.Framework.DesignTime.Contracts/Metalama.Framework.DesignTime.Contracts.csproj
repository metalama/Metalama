<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <AssemblyName>Metalama.Framework.DesignTime.Contracts.v2</AssemblyName>
        <RootNamespace>Metalama.Framework.DesignTime.Contracts</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Packaging -->
        <IsPackable>true</IsPackable>
        <PackageId>Metalama.Framework.DesignTime.Contracts</PackageId>
        <InternalOnlyPackage>True</InternalOnlyPackage>

    </PropertyGroup>

    <ItemGroup>
      <Compile Include="../Metalama.Framework.CompilerExtensions/StandaloneNamedLockService.cs" Link="StandaloneNamedLockService.cs" />
    </ItemGroup>

    <ItemGroup>
        <!-- It is essential that the package version remains constant.-->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.0.1" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="4.0.1" PrivateAssets="all" />

        <!-- This project can have no reference at all, because it is loaded side by side by every Metalama version
             present in one Visual Studio session and must stay version-frozen. It therefore merges the named locks of
             Backstage, and the packages they depend on, into its own assembly. See ILMergePackages.targets. -->
        <PackageReference Include="SharpCrafters.Backstage.Threading" PrivateAssets="all" ILMerge="true" />
        <PackageReference Include="SharpCrafters.Backstage.Abstractions" PrivateAssets="all" ILMerge="true" />
        <PackageReference Include="SharpCrafters.Common.Abstractions" PrivateAssets="all" ILMerge="true" />

        <!-- We must match the version used by the lowest version of Visual Studion supported by the VSX. -->
        <PackageReference Include="Newtonsoft.Json" NoWarn="NU1903" />

        <!-- Microsoft.CodeAnalysis.Workspaces.Common 4.0.1 is pinned to the version of the lowest supported Visual
             Studio, and it depends on System.Net.Http 4.3.0 and System.Text.RegularExpressions 4.3.0. Raising it is
             not an option, and NoWarn on the reference itself does not apply to a transitive dependency. Both
             assemblies are provided by the runtime that hosts us, so the vulnerable package is never loaded. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-7jgj-8wvc-jh57" />
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-cmhx-cq75-c4mj" />
    </ItemGroup>

    <Import Project="../ILMergePackages.targets" />

</Project>
