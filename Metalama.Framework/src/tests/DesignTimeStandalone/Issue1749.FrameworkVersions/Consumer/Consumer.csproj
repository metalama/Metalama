<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- The version built by this repository, which is therefore the one that compiles this project. -->
        <PackageReference Include="Metalama.Framework" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\NewAspects\NewAspects.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- A file reference to an already-built assembly, deliberately not a ProjectReference: NuGet unifies the
             Metalama.Framework version across a project reference, which would erase the very conflict this test
             creates. A package reference to a prebuilt package behaves the same way as this file reference, and is
             what a consumer of an aspect library published against an older Metalama actually has. -->
        <Reference Include="OldAspects" HintPath="..\OldAspects\bin\$(Configuration)\net10.0\OldAspects.dll" />
    </ItemGroup>

</Project>
