<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Inherit the repo's sources (nuget.org, roslyn-consolidated, Metalama, Metalama.Compiler). -->
  <!-- The repo maps Metalama.* to the local Metalama feed, which makes the publicly released Metalama.Framework
       used by OldAspects unresolvable. Every source is therefore mapped to every package, which lets NuGet search
       all of them; both versions used here are pinned exactly, so there is no ambiguity.
       The mapping cannot merely be cleared: central package management requires a mapping as soon as more than one
       source is defined, and restore fails otherwise. The repository has declared a second remote source since the
       roslyn-consolidated feed was added for Roslyn 5.10. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="roslyn-consolidated">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
