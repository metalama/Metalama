<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Inherit the repo's sources (nuget.org, Metalama, Metalama.Compiler). -->
  <!-- The repo maps Metalama.* to the local Metalama feed, which makes the publicly released Metalama.Framework
       used by OldAspects unresolvable. Clearing the mapping lets NuGet search every source; both versions used
       here are pinned exactly, so there is no ambiguity. -->
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
