<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Inherit the repo's sources (nuget.org, Metalama, Metalama.Compiler). -->
  <!-- The repo maps Metalama.* to the local Metalama feed, which makes the publicly released Metalama.Framework
       used by OldAspects unresolvable. Every source is therefore mapped to every package, which lets NuGet search
       all of them; both versions used here are pinned exactly, so there is no ambiguity.
       Every inherited source has to be listed. A source with no mapping is never considered, so omitting the local
       Metalama feed would leave the version of Metalama.Framework built by this repository, which NewAspects and
       Consumer reference, resolvable only from a package cache that a previous restore had filled.
       The mapping cannot merely be cleared: central package management requires a mapping as soon as more than one
       source is defined, and restore fails otherwise. The local Metalama feeds are sources of their own, so more
       than one source is always defined. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Metalama">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Metalama.Compiler">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
