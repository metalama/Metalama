<Project Sdk="Microsoft.NET.Sdk">

    <Import Project="../../../../eng/RoslynVersions/Latest.props" />

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Metalama.Framework.Analyzers.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(ThisRoslynVersion)" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../Metalama.Framework/Metalama.Framework.csproj" />
        <ProjectReference Include="../../Metalama.Framework.Analyzers/Metalama.Framework.Analyzers.csproj" />

        <!-- For CompilationModel, PartialCompilation and CompilationContext, which the correspondence test probes. -->
        <ProjectReference Include="../../Metalama.Framework.Engine/Metalama.Framework.Engine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The correspondence test reads this source rather than a copy of it, so that the two lists cannot drift
             apart silently. Embedding it also means that moving or renaming the file breaks this build, which is
             itself the signal that the test needs attention. -->
        <EmbeddedResource Include="../../Metalama.Framework.Engine/Pipeline/UserCodeRetentionPolicy.cs"
                          LogicalName="UserCodeRetentionPolicy.cs" />

        <!-- Likewise for the immutability classification, whose rules and type lists WellKnownImmutableTypes ports.
             The analyzer cannot reference Metalama.Patterns.Immutability, because that assembly needs the engine's
             options system, so the two lists can only be held together by reading the source. -->
        <EmbeddedResource Include="../../../../Metalama.Patterns/src/Metalama.Patterns.Immutability/ImmutabilityExtensions.cs"
                          LogicalName="ImmutabilityExtensions.cs" />
        <EmbeddedResource Include="../../../../Metalama.Patterns/src/Metalama.Patterns.Immutability/Fabric.cs"
                          LogicalName="ImmutabilityFabric.cs" />
    </ItemGroup>

</Project>
