<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- MutexProbe is a separate project built on its own by test.ps1. Without these exclusions the
       default globbing of this project would also compile its sources, which would result in two
       entry points. -->
  <ItemGroup>
    <Compile Remove="MutexProbe/**" />
    <None Remove="MutexProbe/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Metalama.Framework" />
  </ItemGroup>

</Project>
