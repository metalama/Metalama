{
    // The compiler requires System.Runtime.CompilerServices.IUnion and
    // System.Runtime.CompilerServices.UnionAttribute for a union declaration, and the reference assemblies of a
    // target framework older than .NET 11 do not declare them. The test framework adds the source file of each
    // polyfill named here to the test compilation. They are not added to every test because they declare members,
    // which an aspect or a fabric that enumerates the types of the compilation would then see.
    "IncludedPolyfills": [ "IUnion", "UnionAttribute" ]
}
