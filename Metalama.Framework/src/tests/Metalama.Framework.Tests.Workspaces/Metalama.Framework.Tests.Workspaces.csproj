<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../../../eng/Coverage.props" />


    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Metalama.Framework.Tests.Workspaces</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <ProjectReference Include="../../Metalama.Framework.Workspaces/Metalama.Framework.Workspaces.csproj" />
        <PackageReference Include="Metalama.Compiler.Sdk" />
        <ProjectReference Include="../../Metalama.Testing.UnitTesting/Metalama.Testing.UnitTesting.csproj" />

        <!-- This reference must be repeated in this project because it is marked as private in Metalama.Framework.Workspaces -->
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="$(RoslynMaxVersion)"  />

        <!-- Repeated here for the same reason, and excluded from the run-time assets as in that project: the 17.x
             Microsoft.Build.Framework that the reference above brings in would otherwise be copied beside the test
             assembly and shadow the one of the MSBuild that Microsoft.Build.Locator resolves. On a .NET 10 SDK host
             that means Microsoft.Build 18.0 loading Microsoft.Build.Framework 17.11, which fails with a
             TypeLoadException on IEventSource5. -->
        <PackageReference Include="Microsoft.Build.Framework" VersionOverride="17.11.31" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>


</Project>