<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="../../../../eng/Coverage.props" />


    <PropertyGroup>
        <!-- .NET 10, to match Metalama.Framework.Workspaces. -->
        <TargetFramework>net10.0</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Metalama.Framework.Tests.Workspaces</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <ProjectReference Include="../../Metalama.Framework.Workspaces/Metalama.Framework.Workspaces.csproj" />
        <PackageReference Include="Metalama.Compiler.Sdk" />
        <ProjectReference Include="../../Metalama.Testing.UnitTesting/Metalama.Testing.UnitTesting.csproj" />

        <!-- This reference must be repeated in this project because it is marked as private in Metalama.Framework.Workspaces -->
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="$(RoslynMaxVersion)"  />

        <!-- Microsoft.Build.Framework must not be copied to the output directory, for the reason given in
             Metalama.Framework.Workspaces.csproj. The exclusion has to be repeated here because this project references
             Microsoft.CodeAnalysis.Workspaces.MSBuild directly. -->
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>


</Project>