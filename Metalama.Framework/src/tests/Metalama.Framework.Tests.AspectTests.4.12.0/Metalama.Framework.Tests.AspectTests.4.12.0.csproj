<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This variant runs the whole aspect test suite through the identifier-based durable references, without their
         resolution cache. An aspect test is a batch compilation, whose durable references hold the reference they were
         made from, so without this the identifier resolution path would no longer be covered by the suite that used to
         cover all of it. See issue #1811. -->
    <MetalamaDurableRefKind>SerializableWithoutCache</MetalamaDurableRefKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Metalama.Framework.Tests.AspectTests/**/*.cs" Exclude="../Metalama.Framework.Tests.AspectTests/bin/**/*.cs;../Metalama.Framework.Tests.AspectTests/obj/**/*.cs" />
  </ItemGroup>
  <Import Project="../../../../eng/RoslynVersions/Roslyn.4.12.0.props" />
  <Import Project="../Metalama.Framework.Tests.AspectTests/Metalama.Framework.Tests.AspectTests.csproj" />
</Project>
