<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- This variant runs the aspect test suite with identifier-based durable references and without their resolution
         cache. An aspect test is a batch compilation, and the durable references of a batch compilation store the
         reference they were created from. Without this property, the identifier resolution code would no longer be
         covered by the aspect test suite. See issue #1811. -->
    <MetalamaDurableRefKind>SerializedWithoutCache</MetalamaDurableRefKind>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Metalama.Framework.Tests.AspectTests/**/*.cs" Exclude="../Metalama.Framework.Tests.AspectTests/bin/**/*.cs;../Metalama.Framework.Tests.AspectTests/obj/**/*.cs" />
  </ItemGroup>
  <Import Project="../../../../eng/RoslynVersions/Roslyn.5.0.0.props" />
  <Import Project="../Metalama.Framework.Tests.AspectTests/Metalama.Framework.Tests.AspectTests.csproj" />
</Project>
