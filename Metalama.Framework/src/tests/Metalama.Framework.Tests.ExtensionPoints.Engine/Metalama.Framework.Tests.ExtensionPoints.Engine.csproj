<Project>

    <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" Condition="$(MSBuildThisFileFullPath) == $(MSBuildProjectFullPath)" />

    <!-- The engine of the in-repository proof of concept of the extension points that the call-site interceptors of Metalama.Premium use.
         It uses the public API of Metalama.Framework.Engine only: this assembly must not appear in any InternalsVisibleTo list of Metalama.
         See Metalama.Framework/docs/future/interceptors/12-test-plan.md, section 12.5. -->

    <Import Project="../../../../eng/RoslynVersions/Latest.props" />

    <PropertyGroup>
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <AssemblyName>Metalama.Framework.Tests.ExtensionPoints.Engine.$(ThisRoslynVersionNoPreview)</AssemblyName>
        <RootNamespace>Metalama.Framework.Tests.ExtensionPoints.Engine</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../../Metalama.Framework.Engine$(ThisRoslynVersionProjectSuffix)/Metalama.Framework.Engine$(ThisRoslynVersionProjectSuffix).csproj" />
        <ProjectReference Include="../Metalama.Framework.Tests.ExtensionPoints.Api/Metalama.Framework.Tests.ExtensionPoints.Api.csproj" />
    </ItemGroup>

    <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" Condition="$(MSBuildThisFileFullPath) == $(MSBuildProjectFullPath)" />

</Project>
