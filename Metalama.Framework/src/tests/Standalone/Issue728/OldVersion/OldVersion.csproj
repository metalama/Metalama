<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA1822: IntroducedMethod is an aspect-introduced member; it must be instance-level. -->
    <NoWarn>CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Metalama.Framework" />
  </ItemGroup>

  <ItemGroup>
    <!-- This project must reference an old version of Metalama.Framework, and NuGet reports advisories against that
         version (NU1902, NU1903). The test reports every unexpected diagnostic, so the advisories are suppressed here. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-m6wq-39m7-9xpp" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-h26j-4vp7-x9w2" />
  </ItemGroup>

</Project>
