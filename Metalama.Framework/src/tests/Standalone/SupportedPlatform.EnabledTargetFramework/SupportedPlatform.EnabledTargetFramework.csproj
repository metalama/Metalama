<Project Sdk="Microsoft.NET.Sdk">

    <!-- 'net472' is enabled but not supported: it is at the minimum of Metalama.Framework and below the supported floor
         of .NET Framework 4.8. The inner build for 'net472' must report LAMA0604 once, naming the supported floor and
         the suppression property, and must not report LAMA0600. The inner build for 'net10.0' is supported and must
         report nothing, which proves that the warning is reported per target framework and not per project.
         See https://github.com/metalama/Metalama/issues/2023. -->

    <PropertyGroup>
        <TargetFrameworks>net472;net10.0</TargetFrameworks>
        <OutputType>Library</OutputType>
        <MetalamaCheckSupportedPlatform>True</MetalamaCheckSupportedPlatform>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
    </ItemGroup>

</Project>
