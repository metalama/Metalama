<Project>

    <!-- Regression test for https://github.com/metalama/Metalama/issues/1741.

         Building a Metalama Razor/Blazor project with UseRazorSourceGenerator=false must fail with the
         MetalamaCheckRazorComponentDeclaration error, because the legacy RazorCompileComponentDeclaration pass does
         not provide Metalama with its configuration. This wrapper builds App/App.csproj (which the test harness does
         not build directly, because this directory contains a .proj) and asserts that the build fails with that
         specific error. -->

    <!-- Imports Directory.Build.props of the upper directory. We must do this explicitly because this project has no SDK. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" Condition="Exists('$([MSBuild]::GetPathOfFileAbove(`Directory.Build.props`, `$(MSBuildThisFileDirectory)../`))')" />

    <PropertyGroup>
        <!-- The substring of the expected error message that identifies the MetalamaCheckRazorComponentDeclaration error. -->
        <ExpectedError>does not support the legacy Razor build</ExpectedError>
    </PropertyGroup>

    <Target Name="Build">

        <!-- The build is expected to fail, so we ignore the exit code and inspect the output instead. -->
        <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)App\App.csproj&quot; /t:rebuild /nologo"
              WorkingDirectory="$(MSBuildThisFileDirectory)App"
              IgnoreExitCode="true"
              ConsoleToMSBuild="true">
            <Output TaskParameter="ExitCode" PropertyName="_AppBuildExitCode" />
            <Output TaskParameter="ConsoleOutput" ItemName="_AppBuildOutput" />
        </Exec>

        <PropertyGroup>
            <_AppBuildOutputText>@(_AppBuildOutput, '%0a')</_AppBuildOutputText>
        </PropertyGroup>

        <Error Condition="'$(_AppBuildExitCode)' == '0'"
               Text="Expected the build of App.csproj to fail because Metalama does not support UseRazorSourceGenerator=false, but the build succeeded." />

        <Error Condition="'$(_AppBuildExitCode)' != '0' AND !$(_AppBuildOutputText.Contains('$(ExpectedError)'))"
               Text="The build of App.csproj failed, but not with the expected Metalama error ('$(ExpectedError)'). Actual output:%0a$(_AppBuildOutputText)" />

        <Message Importance="high"
                 Text="App.csproj correctly failed with the expected Metalama error for UseRazorSourceGenerator=false." />

    </Target>

</Project>
