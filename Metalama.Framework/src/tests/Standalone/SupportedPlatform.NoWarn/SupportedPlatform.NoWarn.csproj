<Project Sdk="Microsoft.NET.Sdk">

    <!-- A warning code added to NoWarn suppresses the diagnostic of that dimension and leaves the other dimensions in
         place. NoWarn reaches an MSBuild warning through MSBuildWarningsAsMessages, which Microsoft.Common.targets
         defaults to the value of NoWarn.

         The target framework would report LAMA0600, which NoWarn suppresses. The contributed requirement reports
         LAMA0601, which must survive.
         See https://github.com/metalama/Metalama/issues/1884. -->

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <OutputType>Library</OutputType>
        <MetalamaCheckSupportedPlatform>True</MetalamaCheckSupportedPlatform>
        <NoWarn>$(NoWarn);LAMA0600</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
    </ItemGroup>

    <ItemGroup>
        <MetalamaPlatformRequirement Include="Test.FutureSdk">
            <MinimumSdkVersion>99.0</MinimumSdkVersion>
        </MetalamaPlatformRequirement>
    </ItemGroup>

</Project>
