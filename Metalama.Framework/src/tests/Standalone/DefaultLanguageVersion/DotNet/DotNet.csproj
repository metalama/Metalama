<Project Sdk="Microsoft.NET.Sdk">

    <!-- This project tests that a collection expression, which requires C# 12, compiles in a net10.0 project that does not set LangVersion. I.e. that Metalama does not lower the default C# version of the SDK. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>

        <!-- Reset properties from engineering. -->
        <Nullable></Nullable>
        <LangVersion></LangVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
    </ItemGroup>

</Project>
