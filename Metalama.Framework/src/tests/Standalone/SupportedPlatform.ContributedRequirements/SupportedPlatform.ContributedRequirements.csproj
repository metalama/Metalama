<Project Sdk="Microsoft.NET.Sdk">

    <!-- A requirement contributed by a package other than Metalama.Framework, or declared by the project itself, is
         evaluated on its own and reports its own package. The three requirements below cover the three rules that the
         requirement of Metalama.Framework does not exercise on this build agent: a target framework newer than the
         tested range, a required target platform, and a .NET SDK older than the required one.

         The target framework of the project is in the tested matrix of Metalama.Framework, so no diagnostic may name
         'Metalama.Framework'. That is what makes this scenario an assertion about independent evaluation rather than
         about merged floors.
         See https://github.com/metalama/Metalama/issues/1884. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Library</OutputType>
        <MetalamaCheckSupportedPlatform>True</MetalamaCheckSupportedPlatform>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
    </ItemGroup>

    <ItemGroup>
        <MetalamaPlatformRequirement Include="Test.NewerFramework">
            <MaximumNETCoreAppVersion>9.0</MaximumNETCoreAppVersion>
            <SupportedTargetFrameworksDescription>The tested target frameworks are .NET 8 and .NET 9.</SupportedTargetFrameworksDescription>
        </MetalamaPlatformRequirement>

        <MetalamaPlatformRequirement Include="Test.WindowsOnly">
            <RequiredTargetPlatformIdentifier>windows</RequiredTargetPlatformIdentifier>
        </MetalamaPlatformRequirement>

        <MetalamaPlatformRequirement Include="Test.FutureSdk">
            <MinimumSdkVersion>99.0</MinimumSdkVersion>
        </MetalamaPlatformRequirement>
    </ItemGroup>

</Project>
