<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Reproduction for https://github.com/metalama/Metalama/issues/1743.

        This project and Issue1743.Weaver2 compile the same weaver source file, so they contribute the plug-in type
        'Issue1743.DuplicatedWeaver' under two different assembly identities. Issue1743.Tests references both.
    -->
    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../DuplicatedWeaver.cs" Link="DuplicatedWeaver.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
        <PackageReference Include="Metalama.Framework.Sdk" PrivateAssets="all" />
    </ItemGroup>

</Project>
