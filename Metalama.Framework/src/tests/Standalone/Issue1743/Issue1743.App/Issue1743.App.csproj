<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Reproduction for https://github.com/metalama/Metalama/issues/1743.

        This project references two assemblies that both provide the plug-in type 'Issue1743.DuplicatedWeaver', so
        AspectDriverFactory receives that weaver type name twice, from two assemblies of a different identity. Before
        the fix, indexing the weavers by type name threw ArgumentException ("An element with the same key but a
        different value already exists") out of AspectPipeline.TryInitialize. The expected outcome is now the
        LAMA0077 error declared in the test.json of the parent directory, so this project is expected NOT to build.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="../Issue1743.Aspect/Issue1743.Aspect.csproj" />
        <ProjectReference Include="../Issue1743.Weaver1/Issue1743.Weaver1.csproj" />
        <ProjectReference Include="../Issue1743.Weaver2/Issue1743.Weaver2.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Framework" />
    </ItemGroup>

</Project>
