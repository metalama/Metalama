<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Inherit the repo's sources (nuget.org, Metalama, Metalama.Compiler). -->
  <!-- The repository maps Metalama.* to the local feed, which makes the publicly released versions used by
       OldAspects and MidAspects unresolvable. Every source is therefore mapped to every package, which lets NuGet
       search all of them; every version used here is pinned exactly, so there is no ambiguity.
       The mapping cannot merely be cleared: central package management requires a mapping as soon as more than one
       source is defined, and restore reports NU1507 otherwise. The local Metalama feeds are sources of their own, so
       more than one source is always defined. -->
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Metalama">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Metalama.Compiler">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
