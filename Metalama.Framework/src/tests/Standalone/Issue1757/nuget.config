<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The repository maps Metalama.* to the local feed, which makes the publicly released versions used by
       OldAspects and MidAspects unresolvable. Clearing the mapping lets NuGet search every source; every version
       used here is pinned exactly, so there is no ambiguity. -->
  <packageSourceMapping>
    <clear />
  </packageSourceMapping>
</configuration>
