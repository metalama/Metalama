<Project Sdk="Microsoft.NET.Sdk">


    <PropertyGroup>
        <!-- Only .NET 10. Microsoft.CodeAnalysis.Workspaces.MSBuild 5.10 ships assets for net10.0 and net472 only,
             so a net8.0 or net9.0 build of this project cannot reference MSBuildWorkspace at all. See Directory.Packages.md. -->
        <TargetFrameworks>net10.0</TargetFrameworks>
        <RootNamespace>Metalama.Framework.Workspaces</RootNamespace>
        <UseMetalamaCompiler>Private</UseMetalamaCompiler>
        <!-- Packaging -->
        <PackageDescription>A Metalama package that allows you to load solutions and projects, get their code model, execute Metalama on them, and get the introspection model of the compilation result.</PackageDescription>


        <!-- disable warning NU5100: The assembly 'contentFiles\any\any\**\*.dll' is not inside the 'lib' folder and hence it won't be added as a reference when the package is installed into a
            project. Move it into the 'lib' folder if it needs to be referenced. -->
        <NoWarn>NU5100</NoWarn>

        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddPackageContent</TargetsForTfmSpecificContentInPackage>
    </PropertyGroup>

    <ItemGroup>
        <None Update="buildTransitive/*" Pack="true" PackagePath=""/>
        <None Update="build/*" Pack="true" PackagePath=""/>
    </ItemGroup>


    <ItemGroup>
        <ProjectReference Include="../Metalama.Framework.Engine/Metalama.Framework.Engine.csproj" PrivateAssets="all"/>
        <ProjectReference Include="../Metalama.Framework.Introspection/Metalama.Framework.Introspection.csproj"/>
        <ProjectReference Include="../Metalama.Framework/Metalama.Framework.csproj"/>

        <!-- Validate that we do not expose internal APIs -->
        <ProjectReference Include="../Metalama.Framework.Engine.Analyzers/Metalama.Framework.Engine.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
        <ProjectReference Include="../Metalama.Framework.Analyzers/Metalama.Framework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

        <ProjectReference Include="../Metalama.Framework.Implementation.Package/Metalama.Framework.Implementation.Package.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.Common" VersionOverride="$(RoslynMaxVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynMaxVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RoslynMaxVersion)"/>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" VersionOverride="$(RoslynMaxVersion)"/>

        <!-- The MSBuild assemblies must not be copied to the application directory, because Microsoft.Build.Locator
             resolves them from the .NET SDK. Microsoft.Build.Framework and Microsoft.NET.StringTools arrive as
             transitive dependencies of Microsoft.CodeAnalysis.Workspaces.MSBuild, at versions older than the MSBuild
             of the SDK that Microsoft.Build.Locator selects. A copy in the application directory is found before the
             resolver runs, and the MSBuild of the SDK then fails to load its own types. -->
        <PackageReference Include="Microsoft.Build" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.Build.Locator"/>
        <PackageReference Include="Microsoft.VisualStudio.SolutionPersistence"/>

        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="$(RoslynMaxVersion)" GeneratePathProperty="True" PrivateAssets="all"/>

        <!-- The following reference handles [Memo] -->
        <ProjectReference Include="../Metalama.SourceTransformer/Metalama.SourceTransformer.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>

    <!-- === Packaging === -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/"/>
    </ItemGroup>

    <Target Name="_AddPackageContent">
        <ItemGroup>

            <!-- We include the libs of Microsoft.CodeAnalysis.Workspaces.MSBuild so we can make the dependency on Microsoft.CodeAnalysis.Workspaces.MSBuild
                 completely private, which de facto removes the transitive dependency on Microsoft.Build packages, which confuse LinqPad. -->

            <TfmSpecificPackageFile Include="$(PkgMicrosoft_CodeAnalysis_Workspaces_MSBuild)/lib/$(TargetFramework)/**/*.dll" PackagePath="lib/$(TargetFramework)"/>

            
            <!-- We include the build hosts (included by Microsoft.CodeAnalysis.Workspaces.MSBuild) so that users don't have 
                to reference the Microsoft.CodeAnalysis.Workspaces.MSBuild and possibly mess up versions. -->

            <TfmSpecificPackageFile Include="$(PkgMicrosoft_CodeAnalysis_Workspaces_MSBuild)/contentFiles/any/any/**" PackagePath="contentFiles/any/$(TargetFramework)" BuildAction="None"  CopyToOutput="true" />
        </ItemGroup>
    </Target>

    <Target Name="_FixPackageFiles" BeforeTargets="GenerateNuspec">
        <ItemGroup>
            <_PackageFiles Condition="$([System.String]::Copy('%(_PackageFiles.PackagePath)').StartsWith('contentFiles'))" PackageCopyToOutput="true" />
        </ItemGroup>
    </Target>

    
    
</Project>
