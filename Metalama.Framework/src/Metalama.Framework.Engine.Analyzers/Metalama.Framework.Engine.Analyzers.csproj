<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <Nullable>enable</Nullable>

        <!-- Disable vulnerability checking because this project is not surfacing. -->
        <NuGetAudit>false</NuGetAudit>

        <!-- RS1038 asks that an assembly containing a diagnostic analyzer not reference Microsoft.CodeAnalysis.Workspaces.
             This assembly deliberately carries both the analyzers and MetalamaPerformanceCodeFixProvider, and a code fix
             provider cannot be written without that reference. The analyzers ship only inside this repository, where the
             design-time host always provides Workspaces. -->
        <NoWarn>$(NoWarn);RS1038</NoWarn>
        <InternalOnlyPackage>True</InternalOnlyPackage>

    </PropertyGroup>
    
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RoslynApiMinVersion)" />
    </ItemGroup>

</Project>
