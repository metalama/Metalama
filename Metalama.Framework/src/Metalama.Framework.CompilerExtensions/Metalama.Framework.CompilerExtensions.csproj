<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <RootNamespace>Metalama.Framework.CompilerExtensions</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Packaging -->
        <IsPackable>False</IsPackable>

        <!-- Disable vulnerability checking because this project is not surfacing. -->
        <NuGetAudit>false</NuGetAudit>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Metalama.Compiler.Sdk" PrivateAssets="true">
            <GeneratePathProperty>True</GeneratePathProperty>
        </PackageReference>
        <PackageReference Include="System.Reflection.Emit" />
    </ItemGroup>
     
    <ItemGroup>
      <!-- This project can have no reference at all, because Metalama.Backstage is one of the assemblies that it
           embeds and extracts. It therefore shares the named-lock implementation with Metalama.Backstage by
           compiling the same source files. -->
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)MutexAcl.cs" Link="MutexAcl.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)INamedLock.cs" Link="INamedLock.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)INamedLockService.cs" Link="INamedLockService.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)LockEventArgs.cs" Link="LockEventArgs.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)NamedLockService.cs" Link="NamedLockService.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)NamedLockService.NamedLockBase.cs" Link="NamedLockService.NamedLockBase.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)NamedLockService.OperatingSystemLock.cs" Link="NamedLockService.OperatingSystemLock.cs" />
      <Compile Include="$(MetalamaSharedThreadingSourceDirectory)NamedLockService.ProcessLocalLock.cs" Link="NamedLockService.ProcessLocalLock.cs" />
      <Compile Include="../Metalama.Framework.Engine/Utilities/AssemblyLoaders/*.cs"  />
      <Compile Include="..\Metalama.Framework.DesignTime\RoslynEntryPointTypeNames.cs" Link="RoslynEntryPointTypeNames.cs" />
    </ItemGroup>

    <Target Name="SelectAssembliesToEmbed">
        <!-- Make sure the dependencies to embed have been built. -->
        <MSBuild Projects="../Metalama.Framework.CompilerExtensions.Resources/Metalama.Framework.CompilerExtensions.Resources.csproj" Properties="Configuration=$(Configuration)" />

        <!-- List of assemblies that should not be selected -->
        <PropertyGroup>
            <AssembliesNotToEmbed>
                **/Metalama.*;
                **/Microsoft.CodeAnalysis.*;
                **/System.*;
            </AssembliesNotToEmbed>
        </PropertyGroup>

        <!-- Select assembies -->
        <ItemGroup>
            <DesktopAssemblyToSignAndEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/Metalama.*.dll" />
            <CoreAssemblyToSignAndEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net10.0/Metalama.*.dll" />

            <DesktopAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/*.dll" Exclude="$(AssembliesNotToEmbed)" />
            <!-- System.Text.Json and dependencies must be embedded for .NET Framework because they're not in the runtime -->
            <DesktopAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/System.Text.Json.dll" />
            <DesktopAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/System.Text.Encodings.Web.dll" />
            <DesktopAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/System.IO.Pipelines.dll" />
            <!-- System.IO.Hashing must be embedded as it's not in the runtime or VS hosting environment -->
            <DesktopAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/System.IO.Hashing.dll" />
            <CoreAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net10.0/*.dll" Exclude="$(AssembliesNotToEmbed)" />
            <CoreAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net10.0/System.IO.Hashing.dll" />
            <!-- For .NET Core, System.Text.Json is provided by the parent ALC (Roslyn) - do not embed to avoid dependency cascades -->
            
            <DesktopAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net472/System.Threading.AccessControl.dll" />
            <!-- The second net8.0 segment is the asset folder inside the System.Threading.AccessControl package,
                 which ships net6.0, net7.0 and net8.0 assets at version 8.0.0. It is not our target framework and
                 must not be renamed with the first segment. Update it when that package version is raised to one
                 that ships a net10.0 asset. -->
            <CoreAssemblyToEmbed Include="../Metalama.Framework.CompilerExtensions.Resources/bin/$(Configuration)/net10.0/runtimes/win/lib/net8.0/System.Threading.AccessControl.dll" />
        </ItemGroup>
    </Target>
    
    <!-- The next target is used in the Public build. It signs assemblies before embedding them. -->
    <Target Name="SignAndEmbedAssemblies" DependsOnTargets="SelectAssembliesToEmbed">

        <MakeDir Directories="$(IntermediateOutputPath)DesktopSignable" />
        <MakeDir Directories="$(IntermediateOutputPath)DesktopSigned" />
        <MakeDir Directories="$(IntermediateOutputPath)CoreSignable" />
        <MakeDir Directories="$(IntermediateOutputPath)CoreSigned" />

        <Copy SourceFiles="@(DesktopAssemblyToSignAndEmbed)" DestinationFolder="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSignable" />
        <Copy SourceFiles="@(CoreAssemblyToSignAndEmbed)" DestinationFolder="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSignable" />

        <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSignable" DestinationFile="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSignable.zip" Overwrite="true" /> 
        <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSignable" DestinationFile="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSignable.zip" Overwrite="true" /> 
        
        <Exec Command="dotnet BuildMetalama.dll tools sign &quot;sign -i $(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSignable.zip -o $(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSigned&quot; --nologo" WorkingDirectory="$(MSBuildThisFileDirectory)../../../eng/src/bin/Debug/net10.0" />
        <Exec Command="dotnet BuildMetalama.dll tools sign &quot;sign -i $(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSignable.zip -o $(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSigned&quot; --nologo" WorkingDirectory="$(MSBuildThisFileDirectory)../../../eng/src/bin/Debug/net10.0" />
        
        <Unzip DestinationFolder="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSigned" SourceFiles="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSigned/DesktopSignable.zip" />
        <Unzip DestinationFolder="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSigned" SourceFiles="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSigned/CoreSignable.zip" />
        
        <ItemGroup>
            <_DesktopSignedFileToEmbed Include="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)DesktopSigned/*.dll" />
            <_CoreSignedFileToEmbed Include="$(MSBuildThisFileDirectory)$(IntermediateOutputPath)CoreSigned/*.dll" />

            <EmbeddedResource Include="@(DesktopAssemblyToEmbed)" Link="Resources/Desktop/%(Filename)%(Extension)" />
            <EmbeddedResource Include="@(CoreAssemblyToEmbed)" Link="Resources/Core/%(Filename)%(Extension)" />
            <EmbeddedResource Include="@(_DesktopSignedFileToEmbed)" Link="Resources/Desktop/%(Filename)%(Extension)" />
            <EmbeddedResource Include="@(_CoreSignedFileToEmbed)" Link="Resources/Core/%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>
    
    <!-- The next target is used in the Debug and Release builds. Contrarily to the previous target, it does not sign assemblies before embedding them. -->
    <Target Name="EmbedUnsignedAssemblies" DependsOnTargets="SelectAssembliesToEmbed">
        <ItemGroup>
            <EmbeddedResource Include="@(DesktopAssemblyToEmbed)" Link="Resources/Desktop/%(Filename)%(Extension)" />
            <EmbeddedResource Include="@(CoreAssemblyToEmbed)" Link="Resources/Core/%(Filename)%(Extension)" />
            <EmbeddedResource Include="@(DesktopAssemblyToSignAndEmbed)" Link="Resources/Desktop/%(Filename)%(Extension)" />
            <EmbeddedResource Include="@(CoreAssemblyToSignAndEmbed)" Link="Resources/Core/%(Filename)%(Extension)" />
        </ItemGroup>
    </Target>
    
    <PropertyGroup>
        <PrepareResourcesDependsOn Condition="'$(EngineeringConfiguration)'=='Public' AND '$(DoNotSign)'!='True'">$(PrepareResourcesDependsOn);SignAndEmbedAssemblies</PrepareResourcesDependsOn>
        <PrepareResourcesDependsOn Condition="'$(EngineeringConfiguration)'!='Public' OR '$(DoNotSign)'=='True'">$(PrepareResourcesDependsOn);EmbedUnsignedAssemblies</PrepareResourcesDependsOn>
    </PropertyGroup>

</Project>
