<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <PackageDescription>
            Metalama SDK. Lets you extend Metalama with the Roslyn API. Unlike source generators, which can only add code, an SDK-based aspect weaver can modify existing syntax trees.
        </PackageDescription>
        
        <RootNamespace>Metalama.Framework.Engine</RootNamespace>

        <!-- This is to prevent the Metalama.Compiler.Sdk package to change our nuspec -->
        <MetalamaCompilerDisablePackCustomization>True</MetalamaCompilerDisablePackCustomization>

        
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Metalama.Framework.Engine.4.12.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Engine.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.AspectTests.4.12.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.AspectTests.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.UnitTests.4.12.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.UnitTests.5.10.0" />

        <InternalsVisibleTo Include="Metalama.Framework.Tests.LinkerTests.4.12.0" />
        <InternalsVisibleTo Include="Metalama.Framework.Tests.LinkerTests.5.10.0" />


        <InternalsVisibleTo Include="DynamicProxyGenAssembly2" Key="$(FakeItEasyKey)" LoadsWithinVisualStudio="false" />

        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="$(RoslynApiMinVersion)" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" VersionOverride="$(RoslynApiMinVersion)" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" VersionOverride="$(RoslynApiMinVersion)" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" VersionOverride="$(RoslynApiMinVersion)" />

        <PackageReference Include="Metalama.Compiler.Sdk" />

        <ProjectReference Include="../Metalama.Framework/Metalama.Framework.csproj" PrivateAssets="Analyzers;Build;BuildTransitive" />

        <!-- DocumentKey is declared here and is marked [Durable], so the analyzer verifies it. -->
        <ProjectReference Include="../Metalama.Framework.Analyzers/Metalama.Framework.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />

    </ItemGroup>

    <!-- Packaging -->
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="/" />
        <None Include="build\**\*" Pack="true" PackagePath="build" />
    </ItemGroup>

</Project>
