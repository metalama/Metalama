<Project>
	<PropertyGroup>
		<ThisRoslynVersion>4.12.0</ThisRoslynVersion>
		<!-- This should be non-empty only when using preview version of Roslyn. Then it should be the Roslyn version without the preview part. -->
		<ThisRoslynVersionNoPreview>4.12.0</ThisRoslynVersionNoPreview>
		<!-- ThisRoslynVersionProjectSuffix should be empty for the latest version, otherwise it should be a dot followed by ThisRoslynVersion -->
		<ThisRoslynVersionProjectSuffix>.4.12.0</ThisRoslynVersionProjectSuffix>
		<!-- This variant defines no ROSLYN_* constant. The source expresses it through the #else branch of
		     ROSLYN_5_0_0_OR_GREATER. See Directory.Packages.md. -->
		<SystemTextJsonVersion>8.0.6</SystemTextJsonVersion>

	</PropertyGroup>
</Project>
