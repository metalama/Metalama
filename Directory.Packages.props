<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>

    <!-- Required while .NET SDK 10 is pre-release.  -->
    <RestorePrerelease>true</RestorePrerelease>
  </PropertyGroup>
  <PropertyGroup>
    <!-- 2023.2.398 is the first version that exposes ManySolutions and TestableSolution, which the design-time
         scenarios under Metalama.Framework/src/tests/DesignTimeStandalone derive from. -->
    <PostSharpEngineeringVersion Condition="'$(PostSharpEngineeringVersion)'==''">2023.2.433</PostSharpEngineeringVersion>


    <!-- We must match the version used by the lowest version of Visual Studio supported by the VSX, i.e. VS 17.14. -->
    <NewtonsoftJsonMinVersion>13.0.3</NewtonsoftJsonMinVersion>
    <!-- This is the version used in the programs (not in libraries) and it should be the latest. -->
    <NewtonsoftJsonVersion>13.0.4</NewtonsoftJsonVersion>

     <!-- RoslynApiMinVersion is the minimal version of the Roslyn API we support. The 4.12 build variant was
         dropped for 2027.0: no design-time analyzer host in the supported platform baseline is below Roslyn 5.0,
         and Metalama.Compiler.exe replaces the SDK's Roslyn at build time. See Directory.Packages.md. -->
    <RoslynApiMinVersion>5.0.0</RoslynApiMinVersion>

    <!-- RoslynApiMaxVersion is the maximum version of the Roslyn API we support. It matches the Roslyn version
         that Metalama.Compiler builds on. Roslyn 5.10 is a preview and is restored from the roslyn-consolidated
         feed declared in nuget.base.config. -->
    <RoslynApiMaxVersion>5.10.0-1.26365.3</RoslynApiMaxVersion>
    <!-- RoslynMaxVersion is the version of Roslyn that should be referenced by the Workspaces package. -->
    <RoslynMaxVersion>5.10.0-1.26365.3</RoslynMaxVersion>

    <!-- xUnitApiVersion is the version of xUnit against which we build the testing framework -->
    <xUnitApiVersion>2.9.3</xUnitApiVersion>

    <!-- MicrosoftBuildVersion must not exceed the lowest MSBuild that can host us, because
         Microsoft.Build.Locator binds to the MSBuild of the host at run time and the API compiled against is
         then resolved there. The value is derived from the platform baseline recorded in
         Metalama.Framework/docs/platform-support.md. Under PB-2027.0 Visual Studio 2022 is out of the
         supported set, so the lowest host is the .NET 10 SDK, which ships MSBuild 18.0. 18.0.2 is the lowest
         18.0 published on nuget.org, and it is below the 18.0.7 that .NET SDK 10.0.102 ships. Note that the
         FileVersion of the Microsoft.Build.dll shipped by an integrated development environment is not the
         NuGet version. Always verify that the NuGet package exists before pinning.
         The value is unconditional, because every project that references the Microsoft.Build packages targets
         net10.0, and because this file is imported before the body of the project file, so a condition on
         TargetFramework cannot match in the outer evaluation of a project that declares TargetFramework in the
         singular.
         A project that consumes Microsoft.Build must also reference Microsoft.Build.Framework and
         Microsoft.NET.StringTools with ExcludeAssets="runtime". Without that, a transitive copy of either one
         lands beside the application and shadows the MSBuild that the locator resolved. -->
    <MicrosoftBuildVersion>18.0.2</MicrosoftBuildVersion>

    <!-- These are the latest versions of dependencies, which we use in test projects to avoid vulnerability warnings -->
    <MicrosoftVisualStudioThreadingLatestVersion>17.14.15</MicrosoftVisualStudioThreadingLatestVersion>
    <!-- MessagePack 2.x is required for compatibility with StreamJsonRpc (3.x is incompatible). -->
    <MessagePackLatestVersion>2.5.302</MessagePackLatestVersion>
    <!-- Microsoft.CodeAnalysis 5.10 requires the .NET 10 line of System.Text.Json, Microsoft.Bcl.AsyncInterfaces
         and System.IO.Pipelines. The *LatestVersion properties feed the projects that host themselves, which no
         design-time host loads, so they take the highest patch of that line rather than the 10.0.8 that the
         binding redirects impose on the payload. -->
    <SystemTextJsonLatestVersion>10.0.11</SystemTextJsonLatestVersion>
    <MicrosoftBclAsyncInterfacesLatestVersion>10.0.11</MicrosoftBclAsyncInterfacesLatestVersion>

    <!-- SystemTextJsonVersion is set per Roslyn variant in eng/RoslynVersions, because each Roslyn version
         requires a floor of its own. This fallback governs the projects that are built once and linked into
         every variant, Metalama.Framework.ConfigurationFiles among them, so it must not exceed the lowest
         variant: a higher value makes the Roslyn 5.0 variant a package downgrade and fails restore. -->
    <SystemTextJsonVersion Condition="'$(SystemTextJsonVersion)'==''">9.0.10</SystemTextJsonVersion>
    <!-- SystemTextJsonMinVersion is the version referenced by Metalama.Backstage, which is its only consumer.
         The limit here is the host and not the binding redirect. The core flavour of the design-time payload
         does not embed System.Text.Json, because the parent assembly load context, which is Roslyn, provides it,
         and assembly binding rolls forward and never back. The value must therefore be no higher than the lowest
         version any host in the supported set provides. Microsoft.CodeAnalysis 5.0 requires the 9.0 line and the
         Rider backend presents it, so that line is the limit, and the .NET 10.0 line used elsewhere in this file
         would fail to bind there. 9.0.10 is its highest patch. Its netstandard2.0 and net462 closure is satisfied
         by the Microsoft.Bcl.AsyncInterfaces, System.IO.Pipelines and System.Threading.Tasks.Extensions pinned
         below, and it is the version that Metalama.Vsx ships. Keep it out of the 8.0 line, whose patches carry
         known advisories that reach a user application through Metalama.Backstage. -->
    <SystemTextJsonMinVersion>9.0.10</SystemTextJsonMinVersion>
    <SystemNetHttpLatestVersion>4.3.4</SystemNetHttpLatestVersion>
    <SystemTextRegularExpressionsLatestVersion>4.3.1</SystemTextRegularExpressionsLatestVersion>
    <SystemFormatsAsn1LatestVersion>9.0.10</SystemFormatsAsn1LatestVersion>
    <SystemIOPipelinesLatestVersion>10.0.11</SystemIOPipelinesLatestVersion>
    <!-- System.Buffers has no central pin, because only a few projects need a direct reference to resolve an
         MSB3277 conflict. This property is the version those projects override to. -->
    <SystemBuffersLatestVersion>4.6.1</SystemBuffersLatestVersion>

  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="PostSharp.Engineering.BuildTools" Version="$(PostSharpEngineeringVersion)" />
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.10.0" />
    <PackageVersion Include="JetBrains.Annotations" Version="2025.2.4" />
    <PackageVersion Include="JetBrains.Profiler.SelfApi" Version="2.5.17" />
    <PackageVersion Include="JetBrains.Profiler.Api" Version="1.4.12" />
    <PackageVersion Include="System.Text.Json" Version="$(SystemTextJsonVersion)" /> 
    <!-- With K4os.Hash.xxHash, make sure that the dependency on System.Memory is not higher
         than the one required by the lowest version of Visual Studio supported by the VSX. -->
    <PackageVersion Include="K4os.Hash.xxHash" Version="1.0.8" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <!-- Seven user-surfacing packages of the Microsoft.Extensions family are on the .NET 10.0 line, which is the
         line of PB-2027.0: DependencyInjection, DependencyInjection.Abstractions and Caching.Memory here, and
         Hosting.Abstractions, Logging.Abstractions, Logging and Logging.Console below. Each still publishes a
         netstandard2.0 and a net462 asset on that line. No assembly of this family is present in either flavour
         of the design-time payload built by Metalama.Framework.CompilerExtensions.Resources, so no host caps
         them. They take 10.0.8 because that is the version of the .NET 10.0 line used throughout this file, and
         because their netstandard2.0 and net462 groups then require exactly the pinned versions of the
         out-of-band family and of Microsoft.Bcl.AsyncInterfaces. Measured for #1903; see Directory.Packages.md. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.8" />
    <!-- Microsoft.Bcl.TimeProvider backports System.TimeProvider to net472 and netstandard2.0. Its net462 and
         netstandard2.0 groups require Microsoft.Bcl.AsyncInterfaces of the same version, so the two move
         together and this one cannot exceed the ceiling that governs that package below. -->
    <PackageVersion Include="Microsoft.Bcl.TimeProvider" Version="10.0.8" />
    <!-- Microsoft.Extensions.TimeProvider.Testing is versioned on its own line, not on the .NET runtime line.
         The net462 group of 10.9.0 requires Microsoft.Bcl.TimeProvider 8.0.1, which the 10.0.8 pinned above
         satisfies, so net472 still resolves a single version of the shim. -->
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.9.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    
    <PackageVersion Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <!-- Microsoft.Toolkit.Uwp.Notifications 7.1.3 references vulnerable System.Drawing.Common 4.7.0, so update it here. -->
    <!-- See also #35587 for updating the above package. -->
    <!-- The only consumer is Metalama.Backstage.Desktop.Windows, a net10.0-windows executable that we host
         ourselves, so no design-time host constrains this version. It follows the .NET 10.0 line used
         throughout this file. -->
    <PackageVersion Include="System.Drawing.Common" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.3912.50" />
    <PackageVersion Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageVersion Include="Spectre.Console" Version="0.55.2" />
    <PackageVersion Include="Spectre.Console.Cli" Version="0.55.0" />
    <!-- The lib/net462 folder of this package holds a _._ placeholder, because the assembly is part of .NET
         Framework, so the net472 flavour of the design-time payload carries no copy of it and no binding
         redirect governs it. The netstandard2.0 asset carries assembly version 4.0.0.0 on both the 8.0 and the
         10.0 line. Measured for #1903. -->
    <PackageVersion Include="System.DirectoryServices" Version="10.0.8" />
    <PackageVersion Include="System.IO.Abstractions" Version="22.1.1" />
    <PackageVersion Include="System.IO.Abstractions.TestingHelpers" Version="22.1.1" />
    <PackageVersion Include="System.IO.Hashing" Version="9.0.15" />
    <!-- Metalama.Backstage references this package and is loaded into devenv.exe. The binding-redirect
         oldVersion range in devenv.exe.config of Visual Studio 2026 18.9 is 4.0.0.0-99.0.0.0, redirected to the
         11.0.0.0 that Visual Studio ships, so this package is not capped at 10.0.0.8 the way the rest of the
         payload is. It takes 10.0.8 with the rest of the .NET 10.0 line rather than a higher patch, so that one
         version governs the whole line. Measured for #1903; see Directory.Packages.md. -->
    <PackageVersion Include="System.IO.Packaging" Version="10.0.8" />
    <!-- Out-of-band family. The binding-redirect oldVersion upper bound is AsmVer 6.0.3.0 in devenv.exe.config
         of both Visual Studio 2022 17.14 and Visual Studio 2026 18.9. The lib/net462 asset of NuGet 6.1.2, which
         is what the net472 payload resolves, is exactly 6.0.3.0. The value is also the floor that System.Memory
         4.6.3 requires. No headroom: do not take a version above 6.1.2 before a Visual Studio release ships it
         and moves the redirect. Measured for #1897; see Directory.Packages.md. -->
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="MessagePack" Version="$(MessagePackLatestVersion)" />
    <!-- Out-of-band family. The binding-redirect oldVersion upper bound is AsmVer 4.0.5.0 in devenv.exe.config
         and MSBuild.exe.config of both Visual Studio 2022 17.14 and Visual Studio 2026 18.9. The lib/net462
         asset of NuGet 4.6.3, which is what the net472 payload resolves, is exactly 4.0.5.0. One value therefore
         serves every consumer, but there is no headroom: do not take a version above 4.6.3 before a Visual
         Studio release ships it and moves the redirect. Measured for #1897; see Directory.Packages.md. -->
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Runtime.Serialization.Xml" Version="4.3.0" />
    <PackageVersion Include="System.Text.RegularExpressions" Version="$(SystemTextRegularExpressionsLatestVersion)" />
    <PackageVersion Include="System.Threading" Version="4.3.0" />
    <PackageVersion Include="System.Threading.Thread" Version="4.3.0" />
    <PackageVersion Include="System.Threading.ThreadPool" Version="4.3.0" />
    <!-- Metalama.Framework.CompilerExtensions embeds the net472 asset of this package in the desktop flavour of
         the design-time payload, and Metalama.Vsx merges it into Metalama.Repacked, so the assembly is loaded
         into devenv.exe and the binding redirect governs it. The redirect in Visual Studio 2026 18.9 is
         4.0.0.0-10.0.0.8, and the lib/net462 asset of NuGet 10.0.8 carries exactly 10.0.0.8. There is no
         headroom: do not take a version above 10.0.8 before a Visual Studio release ships it and moves the
         redirect. Measured for #1903; see Directory.Packages.md. -->
    <PackageVersion Include="System.Threading.AccessControl" Version="10.0.8" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Interactive.Async" Version="6.0.1" />
    <PackageVersion Include="System.Linq.Parallel" Version="4.3.0" />
    <PackageVersion Include="System.Reflection.Emit" Version="4.7.0" />
    <!-- Out-of-band family, and a flowed dependency of Metalama.Framework.DesignTime.Rpc. The binding-redirect
         oldVersion upper bound in devenv.exe.config of Visual Studio 2026 18.9 is assembly version 4.2.4.0, and
         the lib/net462 asset of NuGet 4.6.3 carries exactly 4.2.4.0, so 4.6.3 is the highest version the
         design-time payload may take. No headroom: do not take a version above it before a Visual Studio release
         ships one and moves the redirect. It is also the version that the netstandard2.0 and net462 groups of
         the whole .NET 10.0 line require, and it keeps this package on the same 4.6.x line as the rest of the
         out-of-band family, which must move together. Measured for #1903; see Directory.Packages.md. -->
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <!-- These two packages are governed by the Roslyn version, and the constraint is an upper bound rather
         than a lower one. Metalama.Framework is built once and is referenced by every Roslyn variant, and
         the aspect pipeline compiles the compile-time project against the reference set of the variant in
         use. The set of the Roslyn 5.0 variant, which is RoslynApiMinVersion, carries assembly version
         9.0.0.0 of System.Collections.Immutable. An assembly compiled against a higher version than that set
         provides cannot be referenced from it, and the compilation fails with CS1705. The value must
         therefore stay at or below the lowest version that any supported variant provides. Raising it to
         10.0.8 to match the floor of Microsoft.CodeAnalysis.Common 5.10.0 failed 173 tests in build 335379
         with exactly that error. A lower version is safe, because CS1705 is reported only when the version
         used exceeds the version referenced. See Directory.Packages.md. -->
    <PackageVersion Include="System.Collections.Immutable" Version="8.0.0" />
    <PackageVersion Include="System.Reflection.Metadata" Version="8.0.0" /> 


    <PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />

    <PackageVersion Include="DiffEngine" Version="19.1.3" />
    <PackageVersion Include="Metalama.Extensions.DiffEngine" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Extensions.HtmlWriter" Version="$(MetalamaVersion)" />
    <PackageVersion Include="DiffPlex" Version="1.9.0" />
    <PackageVersion Include="LibGit2Sharp" Version="0.31.0" />
    <PackageVersion Include="Microsoft.Build" Version="$(MicrosoftBuildVersion)" />
    <PackageVersion Include="Microsoft.Build.Framework" Version="$(MicrosoftBuildVersion)" />
    <PackageVersion Include="Microsoft.Build.Tasks.Core" Version="$(MicrosoftBuildVersion)" />
    <!-- Microsoft.NET.StringTools is referenced only so that its runtime asset can be excluded, because the MSBuild
         assemblies are resolved from the .NET SDK by Microsoft.Build.Locator. The version must be the one that
         Microsoft.Build requires exactly, otherwise restore fails with NU1605. -->
    <PackageVersion Include="Microsoft.NET.StringTools" Version="$(MicrosoftBuildVersion)" />
    <PackageVersion Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageVersion Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    
    <PackageVersion Include="PostSharp.Patterns.Model" Version="$(PostSharpPackageVersion)" />
    <PackageVersion Include="xunit" Version="$(xUnitApiVersion)" />
    <PackageVersion Include="xunit.assert" Version="$(xUnitApiVersion)" />
    <PackageVersion Include="xunit.abstractions" Version="2.0.3" />
    <PackageVersion Include="xunit.extensibility.core" Version="$(xUnitApiVersion)" />
    <PackageVersion Include="xunit.extensibility.execution" Version="$(xUnitApiVersion)" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="xunit.assemblyfixture" Condition="'$(TargetFramework)'!='net472'" Version="2.2.0" />
    <PackageVersion Include="xunit.assemblyfixture" Condition="'$(TargetFramework)'=='net472'" Version="2.0.3" />
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.61" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.4" />

    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" /> <!-- Must be the lowest supported VS, i.e. 17.14. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="8.0.20" />
    
    <PackageVersion Include="ILRepack" Version="2.0.44" />
    <!-- StreamJsonRpc and MessagePack are both ILMerged into Metalama.Framework.DesignTime.Rpc. Despite the
         merge, the merged intermediate language still binds externally to the flowed dependencies below, so
         raising StreamJsonRpc may shift what those must provide. -->
    <PackageVersion Include="StreamJsonRpc" Version="2.20.17" />
    <!-- The three packages below are the flowed transitive dependencies of Metalama.Framework.DesignTime.Rpc,
         and they follow the .NET 10.0 line at the version the design-time binding redirects admit. The redirect
         oldVersion upper bound in devenv.exe.config of Visual Studio 2026 18.9 is assembly version 10.0.0.8 for
         all three, and 10.0.8 is the NuGet version whose lib/net462 asset carries exactly that. No headroom: do
         not take a version above it before a Visual Studio release ships one and moves the redirect.
         Metalama.Vsx constrains these values at its build and not at its deployment.
         It does not constrain them at deployment. Metalama.Vsx merges Metalama.Backstage, Metalama.Backstage.Tools
         and Metalama.Framework.DesignTime.Rpc into a single Metalama.Repacked assembly with its own identity, so
         an installed extension carries its own copy of that code and the versions pinned here do not reach it.
         Nor does it ship these three packages: an installed Metalama.Vsx 2026.1.5 holds 65 files, among which
         System.IO.Pipelines, System.Diagnostics.DiagnosticSource, Microsoft.Bcl.AsyncInterfaces and
         System.Threading.Tasks.Extensions do not appear. Visual Studio provides them, under the redirects above.
         It does constrain them at its build. That repository enables central transitive pinning, so its own pins
         must not be below what these packages require, or it fails to restore with NU1605. A change here
         therefore belongs in a pull request on metalama/Metalama.Vsx as well.
         Measured for #1903; see Directory.Packages.md. -->
    <PackageVersion Include="System.IO.Pipelines" Version="10.0.8" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="10.0.8" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.8" />


    <PackageVersion Include="Metalama.Backstage" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Backstage.Commands" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Backstage.Tools" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Compiler" Version="$(MetalamaCompilerVersion)" />
    <PackageVersion Include="Metalama.Compiler.Sdk" Version="$(MetalamaCompilerVersion)" />
    <PackageVersion Include="Metalama.Backstage.Testing" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Testing.Hooks" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Framework" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Framework.Redist" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Framework.Workspaces" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Framework.Sdk" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Testing.AspectTesting" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Testing.UnitTesting" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Extensions.DependencyInjection" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Extensions.Metrics" Version="$(MetalamaVersion)" />
    <PackageVersion Include="Metalama.Extensions.Multicast" Version="$(MetalamaVersion)" />


    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="ComparerExtensions" Version="1.1.0" />
    <PackageVersion Include="FakeItEasy" Version="8.3.0" />
    <PackageVersion Include="FakeItEasy.Analyzer.CSharp" Version="6.1.1" />

    <PackageVersion Include="Azure.Messaging.ServiceBus" Version="7.20.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Elfie" Version="1.0.0" />
    <PackageVersion Include="Microsoft.IO.RecyclableMemoryStream" Version="3.0.1" />

    <PackageVersion Include="LINQPad.Reference" Version="1.4.0-preview.1" />
    <PackageVersion Include="LINQPad.Runtime" Version="8.3.7" />
    <PackageVersion Include="SharpZipLib" Version="1.4.2" />


    <PackageVersion Include="Microsoft.CodeAnalysis.Common" Version="$(RoslynApiMinVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="$(RoslynApiMinVersion)" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="$(RoslynApiMaxVersion)" />
    
  
    <!-- These are test-only dependencies for standalone projects. -->
    <PackageVersion Include="Catglobe.ResXFileCodeGenerator" Version="4.1.2" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="1.23.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <!-- Version 1.18.1 maps a target framework to a tooling suffix up to net8.0 only, and reports "Invalid
         combination of TargetFramework and AzureFunctionsVersion is set." on anything newer. Version 2.1.0 is the
         first that maps net10.0. This is needed by the AdditionalCompileTimePackage standalone test. -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="8.0.0" />
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="AwesomeAssertions" Version="8.1.0" />
    <PackageVersion Include="CompiledBindings.WPF" Version="1.0.19.7" />


  </ItemGroup>
</Project>
