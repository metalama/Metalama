<configuration>
  <!-- Roslyn 5.12.0 is published on nuget.org, so the roslyn-consolidated feed, which served the prerelease builds
       of Roslyn 5.10 to 5.12, is no longer declared. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
