<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Roslyn 5.10 is a preview that is not published on nuget.org. The roslyn-consolidated feed caches the
         Microsoft feeds so that the dependencies of older Roslyn versions do not disappear. It is the same feed
         that Metalama.Compiler restores from. -->
    <add key="roslyn-consolidated" value="https://proget.postsharp.net/nuget/roslyn-consolidated/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="roslyn-consolidated">
      <package pattern="Microsoft.CodeAnalysis.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
