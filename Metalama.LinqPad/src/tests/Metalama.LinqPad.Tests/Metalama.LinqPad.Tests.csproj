<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\..\..\eng\Coverage.props" />

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Metalama.LinqPad.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="LINQPad.Runtime" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <ProjectReference Include="..\..\Metalama.LinqPad\Metalama.LinqPad.csproj" />
        <PackageReference Include="Metalama.Compiler.Sdk" />
        <PackageReference Include="Metalama.Testing.UnitTesting" />
        <PackageReference Update="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="coverlet.msbuild">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Must include explicitly because the package has content.
             Use RoslynMaxVersion to match Metalama.Framework.Workspaces dependency. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="$(RoslynMaxVersion)" />

        <!-- The MSBuild assemblies must not be copied to the output directory, for the reason given in
             Metalama.Framework.Workspaces.csproj. The exclusion has to be repeated here, because the reference to
             Microsoft.CodeAnalysis.Workspaces.MSBuild above brings them in transitively and this project registers
             Microsoft.Build.Locator in Initializer.cs. -->
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>