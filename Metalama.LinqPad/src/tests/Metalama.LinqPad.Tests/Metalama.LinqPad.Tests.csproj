<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\..\..\eng\Coverage.props" />

    <PropertyGroup>
        <TargetFramework>net10.0-windows</TargetFramework>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>Metalama.LinqPad.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="LINQPad.Runtime" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <ProjectReference Include="..\..\Metalama.LinqPad\Metalama.LinqPad.csproj" />
        <PackageReference Include="Metalama.Compiler.Sdk" />
        <PackageReference Include="Metalama.Testing.UnitTesting" />
        <PackageReference Update="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="coverlet.msbuild">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- Must include explicitly because the package has content.
             Use RoslynMaxVersion to match Metalama.Framework.Workspaces dependency. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="$(RoslynMaxVersion)" />

        <!-- The reference above brings in a 17.x Microsoft.Build.Framework. Copied beside the test assembly it
             shadows the one of the MSBuild that Microsoft.Build.Locator resolves, which on a .NET 10 SDK host is
             MSBuild 18.0, and loading Microsoft.Build 18.0 beside Microsoft.Build.Framework 17.11 fails with a
             TypeLoadException on IEventSource5. The same reference exists in Metalama.Framework.Workspaces and in
             its test project, for the same reason. Microsoft.NET.StringTools is excluded as well, because
             excluding the run-time assets of a package does not exclude those of its dependencies. -->
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

</Project>