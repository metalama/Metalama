<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\..\..\eng\Coverage.props" />

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>Metalama.Mcp.Tests</RootNamespace>
        <NoWarn>$(NoWarn);LAMA0820</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Metalama.Compiler.Sdk" />
        <PackageReference Include="Metalama.Testing.UnitTesting" />
        <PackageReference Include="ModelContextProtocol.Core" />
        <ProjectReference Include="..\..\Metalama.Mcp\Metalama.Mcp.csproj" />
        <PackageReference Update="coverlet.collector">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Update="coverlet.msbuild">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Same as Metalama.LinqPad.Tests. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" VersionOverride="$(RoslynMaxVersion)" />
        <PackageReference Include="Microsoft.Build.Framework" PrivateAssets="all" ExcludeAssets="runtime" />
        <PackageReference Include="Microsoft.NET.StringTools" PrivateAssets="all" ExcludeAssets="runtime" />
    </ItemGroup>

    <ItemGroup>
        <!-- The end-to-end tests start the server from its own output directory, with its own deps.json, as a client would. -->
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>ServerPath</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)..\..\Metalama.Mcp\bin\$(Configuration)\net10.0\metalama-mcp.dll</_Parameter2>
        </AssemblyAttribute>
        <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
            <_Parameter1>FrogHatteryPath</_Parameter1>
            <_Parameter2>$(MSBuildThisFileDirectory)..\FrogHattery\FrogHattery.csproj</_Parameter2>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
