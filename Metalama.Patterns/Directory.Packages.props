<Project>
    <Import Project="../Directory.Packages.props" />

    <ItemGroup>
        <!-- Patterns are not loaded in VS, so we can apply security updates. The version is stated here rather than
             taken from SystemTextJsonLatestVersion, because that property now follows the .NET 10 floor that Roslyn 5.10
             requires, and System.Text.Json 10.0.x pulls System.Threading.Tasks.Extensions 4.6.3 into these
             user-surfacing packages. -->
        <PackageVersion Update="System.Text.Json" Version="9.0.10" />
    </ItemGroup>
</Project>
