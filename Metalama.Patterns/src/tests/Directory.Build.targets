<Project>

    <!-- Imports Directory.Build.targets of the upper directory. Use this code in any non-root Directory.Build.* even if the file does not exit. -->
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.targets', '$(MSBuildThisFileDirectory)../'))" Condition="Exists('$([MSBuild]::GetPathOfFileAbove(`Directory.Build.targets`, `$(MSBuildThisFileDirectory)../`))')"/>

    <!-- This is not placed in Directory.Build.props as the IsTestProject property is not yet set there. -->
    <ItemGroup Condition="'$(IsTestProject)'=='true'">
        <!-- We include this to disable xUnit shadow copying because it is not compatible with public-signed test assemblies. -->
        <!-- The same is used by Arcade in Roslyn. -->
        <Content Include="$(MSBuildThisFileDirectory)xunit.runner.json" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

    <!-- Test processes run up to twice as many concurrent tests as there are processors, and each test allocates Roslyn compilations.
         With workstation garbage collection, the process was suspended by the garbage collector for most of the time. Server garbage
         collection collects in parallel. The property reaches the .NET test host through runtimeconfig.json. The .NET Framework test
         host reads its own configuration file and ignores it. See #2254. -->
    <PropertyGroup Condition="'$(IsTestProject)'=='true'">
        <ServerGarbageCollection>true</ServerGarbageCollection>
    </PropertyGroup>

</Project>
