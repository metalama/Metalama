<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Configurations>Debug;Release;LamaDebug</Configurations>
        <NoWarn>SA1402,SA1649,SA1623,SA1629</NoWarn>
    </PropertyGroup>

    <ItemGroup>        
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <PackageReference Include="xunit" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Metalama.Testing.AspectTesting" />
        <PackageReference Include="Metalama.Extensions.DiffEngine" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\Metalama.Patterns.Observability\Metalama.Patterns.Observability.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- This test contains a labeled break and a labeled continue. The statements are legal from C# 15 on, and this
             project is pinned to language version 14, so the compilation of the project reports an error for them. The
             test framework reads the file from the source directory and not from the compilation, so removing the file
             from the compilation does not remove the test. Remove these items when the project moves to a language
             version that accepts the statements. See issues #1947 and #1937. -->
        <Compile Remove="LabeledLoopInGetter.cs" />
        <None Include="LabeledLoopInGetter.cs" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="ObservableRecipientBase.cs">
        <DependentUpon>$([System.String]::Copy('ObservableRecipientBase').Substring( %(Filename.IndexOf('.') ).cs</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="IntermediateInterface_ExplicitImpl.cs">
        <DependentUpon>$([System.String]::Copy('IntermediateInterface').Substring( %(Filename.IndexOf('.') ).cs</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
    </ItemGroup>

</Project>