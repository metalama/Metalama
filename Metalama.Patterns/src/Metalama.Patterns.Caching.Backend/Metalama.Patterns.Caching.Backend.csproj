<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net472;net10.0;netstandard2.0</TargetFrameworks>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TransformOnBuild>true</TransformOnBuild>
        <RootNamespace>Metalama.Patterns.Caching</RootNamespace>
        
    </PropertyGroup>


    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>    

    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" PrivateAssets="all" />
        <!-- The only Metalama dependency of this package: a dependency-free assembly holding the test-only
             hooks. The package remains usable without the rest of Metalama. -->
        <PackageReference Include="Metalama.Testing.Hooks" />
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" />
        <PackageReference Include="System.Collections.Immutable" />
        <PackageReference Include="System.Text.Json" />
        <PackageReference Include="Microsoft.IO.RecyclableMemoryStream" />
    </ItemGroup>


    <!-- Microsoft.Bcl.TimeProvider backports System.TimeProvider to the target frameworks that do not have it.
         The item group used to be conditioned on the target framework not being net8.0, which #1876 removed from
         this project. The condition was therefore true for every remaining target framework, and it is dropped
         rather than rewritten, so that the set of references does not change. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Bcl.TimeProvider" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
        <PackageReference Include="System.Runtime.Serialization.Xml" />
        <PackageReference Include="System.Threading" />
        <PackageReference Include="System.Threading.Thread" />
        <PackageReference Include="System.Threading.ThreadPool" />
        <PackageReference Include="System.Text.RegularExpressions" />
        <PackageReference Include="System.Threading.Tasks.Extensions" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
        <PackageReference Include="System.Threading.Tasks.Extensions" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flashtrace.Formatters\Flashtrace.Formatters.csproj" />
        <ProjectReference Include="..\Flashtrace\Flashtrace.csproj" />
        <ProjectReference Include="..\Metalama.Patterns.Contracts\Metalama.Patterns.Contracts.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Metalama.Patterns.Caching.UnitTests" />
        <InternalsVisibleTo Include="Metalama.Patterns.Caching.TestHelpers" />
    </ItemGroup>

    <ItemGroup>
        <Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
    </ItemGroup>

</Project>
